##grflangid 0x00


# GRF name and description
GRF_Name_with_Ver                          :Diversity Train Set {VERSION}
GRF_Desc                                   :Diversity Train Set
GRF_URL                                    :https://github.com/DTS-NewGRF/DTS_World/releases

# Deleted / locomotive's name
NAME_To_Be_Deleted                         : {RED} To Be Deleted

# Parameters
Param_Name_Speed                           : Sets the train speed.
Param_Desc_Speed                           : Selects the operating speed, design speed, or MU control speed.{}- Default: MU Control Speed
Param_Operation_Speed                      : Operating Speed
Param_Design_Speed                         : Design Speed
Param_MU_Operation_Speed                   : MU Control Speed
Param_Name_Regular_Speed_Train             : Conventional Train Speed Control
Param_Desc_Regular_Speed_Train             : Adjusts the speed of all conventional trains collectively.{}- Default: 150 km/h
Param_Name_High_Speed_Train                : High-Speed Train Speed Control
Param_Desc_High_Speed_Train                : Adjusts the speed of all high-speed trains collectively.{}- Default: 331 km/h
Param_Name_High_Speed_Train_430            : High-Speed Train (430km/h) Speed Control
Param_Desc_High_Speed_Train_430            : Adjusts the speed of all high-speed trains collectively.{}- Default: 430 km/h

# Refit (Additional text) Real Trian(BLUE), Test Train(YELLOW), Plan Train(PURPLE), Virtual Train(RED)

# Errors
ERROR_NOT_ENOUGH_LENGTH3                   : It's too short. It should be equal or more than 3 cars at least.
ERROR_NOT_ENOUGH_LENGTH4                   : It's too short. It should be equal or more than 4 cars at least.
ERROR_NOT_ENOUGH_LENGTH6                   : It's too short. It should be equal or more than 6 cars at least.
ERROR_NOT_ENOUGH_LENGTH8                   : It's too short. It should be equal or more than 8 cars at least.

