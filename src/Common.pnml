/*--------------------------------------------------------------------
공통 스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_Test_Cargo_subtype_text, cargo_subtype) {
    1: return string(Livery_Cargo);
    return string(Livery_Test);
}

// 최소편성 설정
switch(FEAT_TRAINS, SELF, sw_start_stop_3Car, num_vehs_in_consist >= 3) {
    1: return CB_RESULT_NO_TEXT;
    return string(ERROR_NOT_ENOUGH_LENGTH3);
}

switch(FEAT_TRAINS, SELF, sw_start_stop_4Car, num_vehs_in_consist >= 4) {
    1: return CB_RESULT_NO_TEXT;
    return string(ERROR_NOT_ENOUGH_LENGTH4);
}

switch(FEAT_TRAINS, SELF, sw_start_stop_6Car, num_vehs_in_consist >= 6) {
    1: return CB_RESULT_NO_TEXT;
    return string(ERROR_NOT_ENOUGH_LENGTH6);
}

switch(FEAT_TRAINS, SELF, sw_start_stop_8Car, num_vehs_in_consist >= 8) {
    1: return CB_RESULT_NO_TEXT;
    return string(ERROR_NOT_ENOUGH_LENGTH8);
}