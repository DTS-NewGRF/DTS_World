스위치
--------------------------------------------------------------------*/
// 도색
switch(FEAT_TRAINS, SELF, sw_FEL_8500_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_FEL_8500);
    1: return string(Livery_FEL_8500_A_train);       // A-Train
    2: return string(Livery_FEL_8500_G_train);       // G-Train
    3: return string(Livery_FEL_8500_S_train);       // S-Train
    4: return string(Livery_FEL_8500_V_train);       // V-Tain
    5: return string(Livery_FEL_8500_Haerang_train); // Haerang
    6: return string(Livery_FEL_8500_Wine_train);    // Wine
    7: return string(Livery_FEL_8500_A_train_New);   // A-Train 신도색
    8: return string(Livery_FEL_8500_G_train_New);   // G-Train 신도색
}

// 열차
switch(FEAT_TRAINS, SELF, sw_FEL_8500_engine_Front, cargo_subtype) {
    0: set_FEL_8500_engine;
    1: set_FEL_8500_A_Train_engine;
    2: set_FEL_8500_G_Train_engine;
    3: set_FEL_8500_S_Train_engine;
    4: set_FEL_8500_V_Train_engine;
    5: set_FEL_8500_Haerang_Train_engine;
    6: set_FEL_8500_Wine_Train_engine;
    7: set_FEL_8500_A_New_Train_engine;
    8: set_FEL_8500_G_New_Train_engine;
}

switch(FEAT_TRAINS, SELF, sw_FEL_8500_engine_Back, cargo_subtype) {
    0: set_FEL_8500_engine_Rev;
    1: set_FEL_8500_A_Train_engine_Rev;
    2: set_FEL_8500_G_Train_engine_Rev;
    3: set_FEL_8500_S_Train_engine_Rev;
    4: set_FEL_8500_V_Train_engine_Rev;
    5: set_FEL_8500_Haerang_Train_engine_Rev;
    6: set_FEL_8500_Wine_Train_engine_Rev;
    7: set_FEL_8500_A_New_Train_engine_Rev;
    8: set_FEL_8500_G_New_Train_engine_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_FEL_8500_engine, train_is_driving_backwards) {
    0: sw_FEL_8500_engine_Front;
    1: sw_FEL_8500_engine_Back;
}