/*--------------------------------------------------------------------
DHC_PP
--------------------------------------------------------------------*/
// Graphics
#include "DHC_PP_graphic.pnml"

// Switch
#include "DHC_PP_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DHC_PP, 2356){
    property {
        name:                           string(NAME_Group_DHC_PP);
        climates_available:             NO_CLIMATE;
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          2955 kW;
        }

    graphics {
        purchase:                       sw_DHC_PP_engine_A_purchase;
        }
        }

/*--------------------------------------------------------------------
열차정보
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DHC_PP_engine_A, 1180){
    property {
        name:                           string(NAME_DHC_PP_engine_A);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1987, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  DHC_PP;
        
        //spec
        speed:                          151km/h;
        power:                          1138 kW;
        weight:                         70 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        visual_effect_and_powered:      VISUAL_EFFECT_DISABLE;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 24;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

    graphics {
        default:                        sw_DHC_PP_engine_A;
        purchase:                       sw_DHC_PP_engine_A_purchase;
        speed:                          sw_Regular_150_speed;
        cargo_subtype_text:             sw_DHC_PP_engine_A_cargo_subtype_text;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_MTU396TCstart_sound;
        start_stop:                     sw_start_stop_4Car;
        }
        }

