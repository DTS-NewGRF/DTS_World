// 기관차
switch(FEAT_TRAINS, SELF, sw_DHC_PP_engine_A, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DHC_PP_engineT_A;
    sw_DHC_PP_engineH_A;
}

switch(FEAT_TRAINS, SELF, sw_DHC_PP_engine_B, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DHC_PP_engineT_B;
    sw_DHC_PP_engineH_B;
}

// 량수별 수송량
switch(FEAT_TRAINS, SELF, sw_DHC_PP_wagon_capacity_in_custom, cargo_subtype) {
     1: return 50;
     2: return 68;
     5: return 60;
     6..7: return 50;
     8: return 68;
    11: return 60;
    12..13: return 50;
    14: return 50;
    17: return 60;
    18..19: return 50;
    20: return 68;
    23: return 60;
    24..25: return 50;
    26: return 68;
    29: return 60;
    30..31: return 50;
    32: return 68;
    35: return 60;
    36..37: return 50;
       64;
}

