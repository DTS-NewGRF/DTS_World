/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_RDC_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_Mugunghwa);
    1: return string(Livery_Pohang_Yeongdeok_1);
    2: return string(Livery_Pohang_Yeongdeok_2);
}

switch(FEAT_TRAINS, SELF, sw_RDC_wagon_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_Mugunghwa);
    1: return string(Livery_Mugunghwa_cafe);
    2: return string(Livery_Pohang_Yeongdeok_1);
    3: return string(Livery_Pohang_Yeongdeok_2);
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_RDC_engineH_Front, cargo_subtype) {
    0: set_Mugunghwa_engineH;
    1: set_Pohang_Yeongdeok_1_engineH;
    2: set_Pohang_Yeongdeok_2_engineH;
}

switch(FEAT_TRAINS, SELF, sw_RDC_wagon, cargo_subtype) {
    0: set_Mugunghwa_wagon;
    1: set_Mugunghwa_wagon_Cafe;
    2: set_Pohang_Yeongdeok_1_wagon;
    3: set_Pohang_Yeongdeok_2_wagon;
}

switch(FEAT_TRAINS, SELF, sw_RDC_engineT_Front, cargo_subtype) {
    0: set_Mugunghwa_engineT;
    1: set_Pohang_Yeongdeok_1_engineT;
    2: set_Pohang_Yeongdeok_2_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_RDC_engineH_Back, cargo_subtype) {
    0: set_Mugunghwa_engineH_Rev;
    1: set_Pohang_Yeongdeok_1_engineH_Rev;
    2: set_Pohang_Yeongdeok_2_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_RDC_engineT_Back, cargo_subtype) {
    0: set_Mugunghwa_engineT_Rev;
    1: set_Pohang_Yeongdeok_1_engineT_Rev;
    2: set_Pohang_Yeongdeok_2_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_RDC_engineH, train_is_driving_backwards) {
    0: sw_RDC_engineH_Front;
    1: sw_RDC_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_RDC_engineT, train_is_driving_backwards) {
    0: sw_RDC_engineT_Front;
    1: sw_RDC_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_RDC_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_RDC_engineT;
    sw_RDC_engineH;
}