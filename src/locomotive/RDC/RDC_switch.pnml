/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_RDC_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_Mugunghwa);
    1: return string(Livery_Pohang_Yeongdeok_1);
    2: return string(Livery_Pohang_Yeongdeok_2);
    3: return string(Livery_Mugunghwa_2cc);
    4: return string(Livery_Gyeongbuk_Atype);
    5: return string(Livery_Gyeongbuk_Btype);
    6: return string(Livery_Gyeongbuk_Ctype);
}

switch(FEAT_TRAINS, SELF, sw_RDC_wagon_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_Mugunghwa);
    1: return string(Livery_Mugunghwa_cafe);
    2: return string(Livery_Pohang_Yeongdeok_1);
    3: return string(Livery_Pohang_Yeongdeok_2);
    4: return string(Livery_Mugunghwa_2cc);
    5: return string(Livery_Mugunghwa_cafe_2cc);
    6: return string(Livery_Gyeongbuk_Atype);
    7: return string(Livery_Gyeongbuk_Btype);
    8: return string(Livery_Gyeongbuk_Ctype);
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_RDC_engineH_Front, cargo_subtype) {
    0: set_Mugunghwa_engineH;
    1: set_Pohang_Yeongdeok_1_engineH;
    2: set_Pohang_Yeongdeok_2_engineH;
    3: set_Mugunghwa_2cc_engineH;
    4: set_RDC_Gyeongbuk_Old_engineH;
    5: set_RDC_Gyeongbuk_New_engineH;
    6: set_RDC_Gyeongbuk_Nadri_engineH;
}

switch(FEAT_TRAINS, SELF, sw_RDC_Gyeongbuk_Old_wagon, position_in_vehid_chain % 2) {
    1: set_RDC_Gyeongbuk_Old_wagon_M2;
    set_RDC_Gyeongbuk_Old_wagon_M1;
}

switch(FEAT_TRAINS, SELF, sw_RDC_Gyeongbuk_New_wagon, position_in_vehid_chain % 2) {
    1: set_RDC_Gyeongbuk_New_wagon_M2;
    set_RDC_Gyeongbuk_New_wagon_M1;
}

switch(FEAT_TRAINS, SELF, sw_RDC_Gyeongbuk_Nadri_wagon, position_in_vehid_chain % 2) {
    1: set_RDC_Gyeongbuk_Nadri_wagon_M2;
    set_RDC_Gyeongbuk_Nadri_wagon_M1;
}
switch(FEAT_TRAINS, SELF, sw_RDC_wagon, cargo_subtype) {
    0: set_Mugunghwa_wagon;
    1: set_Mugunghwa_wagon_Cafe;
    2: set_Pohang_Yeongdeok_1_wagon;
    3: set_Pohang_Yeongdeok_2_wagon;
    4: set_Mugunghwa_2cc_wagon;
    5: set_Mugunghwa_2cc_wagon_Cafe;
    6: sw_RDC_Gyeongbuk_Old_wagon;
    7: sw_RDC_Gyeongbuk_New_wagon;
    8: sw_RDC_Gyeongbuk_Nadri_wagon;
}

switch(FEAT_TRAINS, SELF, sw_RDC_engineT_Front, cargo_subtype) {
    0: set_Mugunghwa_engineT;
    1: set_Pohang_Yeongdeok_1_engineT;
    2: set_Pohang_Yeongdeok_2_engineT;
    3: set_Mugunghwa_2cc_engineT;
    4: set_RDC_Gyeongbuk_Old_engineT;
    5: set_RDC_Gyeongbuk_New_engineT;
    6: set_RDC_Gyeongbuk_Nadri_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_RDC_engineH_Back, cargo_subtype) {
    0: set_Mugunghwa_engineH_Rev;
    1: set_Pohang_Yeongdeok_1_engineH_Rev;
    2: set_Pohang_Yeongdeok_2_engineH_Rev;
    3: set_Mugunghwa_2cc_engineH_Rev;
    4: set_RDC_Gyeongbuk_Old_engineH_Rev;
    5: set_RDC_Gyeongbuk_New_engineH_Rev;
    6: set_RDC_Gyeongbuk_Nadri_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_RDC_engineT_Back, cargo_subtype) {
    0: set_Mugunghwa_engineT_Rev;
    1: set_Pohang_Yeongdeok_1_engineT_Rev;
    2: set_Pohang_Yeongdeok_2_engineT_Rev;
    3: set_Mugunghwa_2cc_engineT_Rev;
    4: set_RDC_Gyeongbuk_Old_engineT_Rev;
    5: set_RDC_Gyeongbuk_New_engineT_Rev;
    6: set_RDC_Gyeongbuk_Nadri_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_RDC_engineH, train_is_driving_backwards) {
    0: sw_RDC_engineH_Front;
    1: sw_RDC_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_RDC_engineT, train_is_driving_backwards) {
    0: sw_RDC_engineT_Front;
    1: sw_RDC_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_RDC_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_RDC_engineT;
    sw_RDC_engineH;
}