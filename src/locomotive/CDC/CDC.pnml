/*--------------------------------------------------------------------
CDC
--------------------------------------------------------------------*/
// Graphics
#include "CDC_graphic.pnml"

// Switch
#include "CDC_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, CDC_engine, 1133){
    property {
        name:                           string(NAME_CDC_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1995, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        
        //spec
        speed:                          121km/h;
        power:                          261 kW;
        weight:                         50 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 100;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

	graphics {
        default:                        sw_CDC_engine;
        purchase:                       sw_CDC_purchase;
        speed:                          sw_Regular_120_speed;
        cargo_subtype_text:             sw_CDC_cargo_subtype_text;
        cargo_capacity:                 sw_CDC_engine_capacity_in_custom;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_Cummins_DMU_start_sound;
        start_stop:                     sw_start_stop_3Car;
        }
        }

/*--------------------------------------------------------------------
객차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, CDC_wagon, 1134){
    property {
        name:                           string(NAME_CDC_wagon);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(1995, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  Train_Car;
        
        //spec
        weight:                         50 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 130;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

	graphics {
        default:                        sw_CDC_wagon;
        purchase:                       sw_CDC_wagon_purchase;
        cargo_subtype_text:             sw_CDC_cargo_subtype_text;
        cargo_capacity:                 sw_CDC_wagon_capacity_in_custom;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        power:                          700;
        }
        }