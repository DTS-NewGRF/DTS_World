/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_CDC_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_CDC_Old);
    1: return string(Livery_CDC_Flower);
    2: return string(Livery_CDC_Baekje);
    3: return string(Livery_CDC_Beach);
    4: return string(Livery_CDC_New);
}

// 도색그래픽 세팅
// 전진방향
switch(FEAT_TRAINS, SELF, sw_CDC_engineH_Front, cargo_subtype) {
    0: set_CDC_Old_engineH;
    1: set_CDC_Flower_engineH;
    2: set_CDC_Baekje_engineH;
    3: set_CDC_Beach_engineH;
    4: set_CDC_New_engineH;
}

switch(FEAT_TRAINS, SELF, sw_CDC_wagon, cargo_subtype) {
    0: set_CDC_Old_wagon;
    1: set_CDC_Flower_wagon;
    2: set_CDC_Baekje_wagon;
    3: set_CDC_Beach_wagon;
    4: set_CDC_New_wagon;
}

switch(FEAT_TRAINS, SELF, sw_CDC_engineT_Front, cargo_subtype) {
    0: set_CDC_Old_engineT;
    1: set_CDC_Flower_engineT;
    2: set_CDC_Baekje_engineT;
    3: set_CDC_Beach_engineT;
    4: set_CDC_New_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_CDC_engineH_Back, cargo_subtype) {
    0: set_CDC_Old_engineH_Rev;
    1: set_CDC_Flower_engineH_Rev;
    2: set_CDC_Baekje_engineH_Rev;
    3: set_CDC_Beach_engineH_Rev;
    4: set_CDC_New_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_CDC_engineT_Back, cargo_subtype) {
    0: set_CDC_Old_engineT_Rev;
    1: set_CDC_Flower_engineT_Rev;
    2: set_CDC_Baekje_engineT_Rev;
    3: set_CDC_Beach_engineT_Rev;
    4: set_CDC_New_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_CDC_engineH, train_is_driving_backwards) {
    0: sw_CDC_engineH_Front;
    1: sw_CDC_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_CDC_engineT, train_is_driving_backwards) {
    0: sw_CDC_engineT_Front;
    1: sw_CDC_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_CDC_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_CDC_engineT;
    sw_CDC_engineH;
}