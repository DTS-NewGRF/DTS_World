// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_VHST_600X_engineH, train_is_driving_backwards) {
    0: set_VHST_600X_engineH;
    1: set_VHST_600X_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_VHST_600X_engineT, train_is_driving_backwards) {
    0: set_VHST_600X_engineT;
    1: set_VHST_600X_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_VHST_600X_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_VHST_600X_engineT;
    sw_VHST_600X_engineH;
}