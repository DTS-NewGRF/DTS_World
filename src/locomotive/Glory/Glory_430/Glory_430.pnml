/*--------------------------------------------------------------------
Glory 430
--------------------------------------------------------------------*/
// Graphics
#include "Glory_430_graphic.pnml"

// Switch
#include "Glory_430_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, Glory_430_engine, 1109){
    property {
        name:                           string(NAME_Glory_430_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2035, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        dual_headed:                    1;
        
        //spec
        speed:                          430km/h;
        power:                          10000 kW;
        weight:                         42 ton;
        tractive_effort_coefficient:    0.9;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        visual_effect_and_powered:      VISUAL_EFFECT_DISABLE;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 61;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP,TRAIN_FLAG_MU, TRAIN_FLAG_AUTOREFIT);
        extra_weight_per_wagon:         35 ton;
        }
        
    graphics {
        default:                        sw_Glory_430_engine;
        purchase:                       set_Glory_430_engine_purchase;
        speed:                          sw_High_430_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_TOSHIBAIGBTPMSMstart_sound;
        }
        }

/*--------------------------------------------------------------------
객차
--------------------------------------------------------------------*/
