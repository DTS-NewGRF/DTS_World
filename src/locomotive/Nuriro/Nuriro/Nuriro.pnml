/*--------------------------------------------------------------------
한국철도공사 200000호대 전동차 (누리로)
--------------------------------------------------------------------*/
// Graphics
#include "Nuriro_graphic.pnml"

// Switch
#include "Nuriro_switch.pnml"

/*--------------------------------------------------------------------
실존편성
--------------------------------------------------------------------*/
item(FEAT_TRAINS, Nuriro_4Car, 2324){
    property {
        name:                           string(NAME_Nuriro_4Car);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2008, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  Nuriro_Logo;
        
        //spec
        speed:                          151km/h;
        power:                          1000 kW;
        weight:                         132 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 66;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

	graphics {
        default:                        sw_Nuriro_4Car;
        articulated_part:               sw_articulated_Nuriro_4Car;
        purchase:                       set_Nuriro_purchase;
        speed:                          sw_Regular_150_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        cargo_subtype_text:             sw_Nuriro_cargo_subtype_text;
        sound_effect:                   sw_HITACHIStart_sound;
        }
        }

/*--------------------------------------------------------------------
자유편성
--------------------------------------------------------------------*/
item(FEAT_TRAINS, Nuriro_engine, 1023){
    property {
        name:                           string(NAME_Nuriro_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2008, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  Nuriro_Logo;
        dual_headed:                    1;
        
        //spec
        speed:                          151km/h;
        power:                          500 kW;
        weight:                         33 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 66;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

     graphics {
        default:                        sw_Nuriro_engine_Free;
        purchase:                       set_Nuriro_engine_purchase;
        speed:                          sw_Regular_150_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        cargo_subtype_text:             sw_Nuriro_cargo_subtype_text;
        sound_effect:                   sw_HITACHIStart_sound;
        start_stop:                     sw_start_stop_4Car;
        }
     
     livery_override(Nuriro_wagon) {
        default:                        sw_Nuriro_wagon_Free;
        loading_speed:                  25;
        cargo_capacity:                 66;
        weight:                         33;
        power:                          335;
        }
        }

