/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_H2_WJ_engineH, train_is_driving_backwards) {
    0: set_H2_WJ_engineH;
    1: set_H2_WJ_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_H2_WJ_engineT, train_is_driving_backwards) {
    0: set_H2_WJ_engineT;
    1: set_H2_WJ_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_H2_WJ_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_H2_WJ_engineT;
    sw_H2_WJ_engineH;
}

// 삭제예정
switch (FEAT_TRAINS, SELF, sw_H2_WJ_4car, position_in_vehid_chain % 4) {
    1..3:set_Deleted_B;
    set_Deleted_A; //default
    }

switch (FEAT_TRAINS, SELF, sw_articulated_H2_WJ_4car, extra_callback_info1) {
    1..3: H2_WJ_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }