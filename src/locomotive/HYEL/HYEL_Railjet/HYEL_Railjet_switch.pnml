// 도색명
switch(FEAT_TRAINS, SELF, sw_HYEL_Railjet_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_HYEL_Railjet_M);
    1: return string(Livery_HYEL_Railjet_Tail);
}

// 객차
switch(FEAT_TRAINS, SELF, sw_HYEL_Railjet_wagon, cargo_subtype) {
    0: set_HYEL_Railjet_wagon;
    1: set_HYEL_Railjet_wagon_tail;
}