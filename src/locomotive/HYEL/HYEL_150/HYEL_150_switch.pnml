/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색
switch(FEAT_TRAINS, SELF, sw_HYEL_150_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_HYEL_150);
    1: return string(Livery_HYEL_150_SB);        // 바다도색
}

// 도색그래픽 세팅
// 전진방향
switch(FEAT_TRAINS, SELF, sw_HYEL_150_engine_Front, cargo_subtype) {
    0: set_HYEL_150_engine;
    1: set_HYEL_150_SB_engine;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_HYEL_150_engine_Back, cargo_subtype) {
    0: set_HYEL_150_engine_Rev;
    1: set_HYEL_150_SB_engine_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_150_engine, train_is_driving_backwards) {
    0: sw_HYEL_150_engine_Front;
    1: sw_HYEL_150_engine_Back;
}