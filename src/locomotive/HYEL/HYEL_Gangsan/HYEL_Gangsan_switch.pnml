// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_Gangsan_engine, train_is_driving_backwards) {
    0: set_HYEL_Gangsan_engineH;
    1: set_HYEL_Gangsan_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon_TC, train_is_driving_backwards) {
    0: set_HYEL_Gangsan_wagon_TC;
    1: set_HYEL_Gangsan_wagon_TC_Rev;
}

// 객차
switch(FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon, position_in_vehid_chain) {
    0: set_HYEL_Gangsan_wagon_3T;
    set_HYEL_Gangsan_wagon_T;
}