스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon_TC, train_is_driving_backwards) {
    0: set_HYEL_Gangsan_wagon_TC;
    1: set_HYEL_Gangsan_wagon_TC_Rev;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon_3car_front, position_in_vehid_chain) {
    0: set_HYEL_Gangsan_wagon_3T;
    set_HYEL_Gangsan_wagon_T;
}

switch (FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon_front, position_in_vehid_chain) {
    0: set_HYEL_Gangsan_wagon_M;
    set_HYEL_Gangsan_wagon_T;
}

switch (FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon_3car, position_in_consist_from_end) {
    0: sw_HYEL_Gangsan_wagon_TC;
    sw_HYEL_Gangsan_wagon_3car_front;
}

switch (FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon_nomal, position_in_consist_from_end) {
    0: sw_HYEL_Gangsan_wagon_TC;
    sw_HYEL_Gangsan_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_HYEL_Gangsan_wagon, num_vehs_in_vehid_chain) {
    2: sw_HYEL_Gangsan_wagon_3car;
    sw_HYEL_Gangsan_wagon_nomal;
}