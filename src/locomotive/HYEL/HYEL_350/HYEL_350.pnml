/*--------------------------------------------------------------------
HYEL-350
--------------------------------------------------------------------*/
// Graphics
#include "HYEL_350_graphic.pnml"

// Switch
#include "HYEL_350_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, HYEL_350_engine, 1119){
    property {
        name:                           string(NAME_HYEL_350_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2040, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  HYEL_Logo;
        dual_headed:                    1;
        
        //spec
        speed:                          331km/h;
        power:                          8800 kW;
        weight:                         30 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        visual_effect_and_powered:      VISUAL_EFFECT_DISABLE;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 120;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT);
        extra_weight_per_wagon:         35 ton;
        }
        
    graphics {
        default:                        sw_HYEL_350_engine;
        purchase:                       set_HYEL_350_engine_purchase;
        speed:                          sw_High_330_speed;
        cost_factor:                    10;
        loading_speed:                  25;
        running_cost_factor:            150;
        sound_effect:                   sw_TOSHIBAIGBTPMSMstart_sound;
        }
        }

/*--------------------------------------------------------------------
객차
--------------------------------------------------------------------*/
