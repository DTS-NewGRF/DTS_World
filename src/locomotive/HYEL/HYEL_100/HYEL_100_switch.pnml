// 도색
switch(FEAT_TRAINS, SELF, sw_HYEL_100_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_HYEL_100);
    1: return string(Livery_HYEL_100_CI);        // CI
    2: return string(Livery_HYEL_100_original);  // 오리지널
}

// 열차
switch(FEAT_TRAINS, SELF, sw_HYEL_100_engine, cargo_subtype) {
    0: set_HYEL_100_H2_engine;
    1: set_HYEL_100_CI_engine;
    2: set_HYEL_100_engine;
}