/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_400_engineH, train_is_driving_backwards) {
    0: set_HYEL_400_engineH;
    1: set_HYEL_400_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_400_engineT, train_is_driving_backwards) {
    0: set_HYEL_400_engineT;
    1: set_HYEL_400_engineT_Rev;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_HYEL_400_7car, position_in_vehid_chain % 7) {
    0: sw_HYEL_400_engineH;
    1: set_HYEL_400_wagon1;
    2: set_HYEL_400_wagon2;
    3: set_HYEL_400_wagon3;
    4: set_HYEL_400_wagon4;
    5: set_HYEL_400_wagon5;
    6: sw_HYEL_400_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_HYEL_400_7car, extra_callback_info1) {
    1..6: HYEL_400_7Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }