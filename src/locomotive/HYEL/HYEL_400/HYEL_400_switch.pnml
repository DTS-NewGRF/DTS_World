/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_400_engineH, train_is_driving_backwards) {
    0: set_HYEL_400_engineH;
    1: set_HYEL_400_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_400_engineT, train_is_driving_backwards) {
    0: set_HYEL_400_engineT;
    1: set_HYEL_400_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_HYEL_400_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_HYEL_400_engineT;
    sw_HYEL_400_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_HYEL_400_wagon_5car, position_in_vehid_chain % 5) {
    0: set_HYEL_400_wagon1;
    1: set_HYEL_400_wagon2;
    2: set_HYEL_400_wagon3;
    3: set_HYEL_400_wagon4;
    4: set_HYEL_400_wagon5;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_HYEL_400_wagon_5car, extra_callback_info1) {
    1..4: HYEL_400_wagon_5car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }