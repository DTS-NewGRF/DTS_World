/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_HYEL_PEX_Super_A);
    1: return string(Livery_HYEL_PEX_Super_B); // 무지개
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engineH_Front, cargo_subtype) {
    0: set_HYEL_PEX_Super_WPC1_engineH;
    1: set_HYEL_PEX_Super_RPC1_engineH;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engineT_Front, cargo_subtype) {
    0: set_HYEL_PEX_Super_WPC2_engineT;
    1: set_HYEL_PEX_Super_RPC2_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engineH_Back, cargo_subtype) {
    0: set_HYEL_PEX_Super_WPC1_engineH_Rev;
    1: set_HYEL_PEX_Super_RPC1_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engineT_Back, cargo_subtype) {
    0: set_HYEL_PEX_Super_WPC2_engineT_Rev;
    1: set_HYEL_PEX_Super_RPC2_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engineH, train_is_driving_backwards) {
    0: sw_HYEL_PEX_Super_engineH_Front;
    1: sw_HYEL_PEX_Super_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engineT, train_is_driving_backwards) {
    0: sw_HYEL_PEX_Super_engineT_Front;
    1: sw_HYEL_PEX_Super_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_HYEL_PEX_Super_engineT;
    sw_HYEL_PEX_Super_engineH;
}