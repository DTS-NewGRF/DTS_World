/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전진방향
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engine_Front, random_bits % 2) {
     0: set_HYEL_PEX_Super_WPC_engine;
     1: set_HYEL_PEX_Super_RPC_engine;
    set_HYEL_PEX_Super_WPC_engine;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_TC_wagon_Front, random_bits % 2) {
     0: set_HYEL_PEX_Super_TC_wagon;
     1: set_HYEL_PEX_Super_STC_wagon;
    set_HYEL_PEX_Super_TC_wagon;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engine_Back, random_bits % 2) {
     0: set_HYEL_PEX_Super_WPC_engine_Rev;
     1: set_HYEL_PEX_Super_RPC_engine_Rev;
    set_HYEL_PEX_Super_WPC_engine_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_TC_wagon_Back, random_bits % 2) {
     0: set_HYEL_PEX_Super_TC_wagon_Rev;
     1: set_HYEL_PEX_Super_STC_wagon_Rev;
    set_HYEL_PEX_Super_TC_wagon_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_engine, train_is_driving_backwards) {
    0: sw_HYEL_PEX_Super_engine_Front;
    1: sw_HYEL_PEX_Super_engine_Back;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_TC_wagon, train_is_driving_backwards) {
    0: sw_HYEL_PEX_Super_TC_wagon_Front;
    1: sw_HYEL_PEX_Super_TC_wagon_Back;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_FTC_wagon, train_is_driving_backwards) {
    0: set_HYEL_PEX_Super_FTC_wagon;
    1: set_HYEL_PEX_Super_FTC_wagon_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_POST_wagon, train_is_driving_backwards) {
    0: set_HYEL_PEX_Super_POST_wagon;
    1: set_HYEL_PEX_Super_POST_wagon_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_PEX_Super_GANERATOR_wagon, train_is_driving_backwards) {
    0: set_HYEL_PEX_Super_GANERATOR_wagon;
    1: set_HYEL_PEX_Super_GANERATOR_wagon_Rev;
}