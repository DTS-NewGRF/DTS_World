/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
switch(FEAT_TRAINS, SELF, sw_HYEL_120_Dual_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: set_HYEL_120_Dual_engine_PC2;
    set_HYEL_120_Dual_engine_PC1;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_HYEL_120_Dual_engine_PC1, train_is_driving_backwards) {
    0: set_HYEL_120_Dual_engine_PC1;
    1: set_HYEL_120_Dual_engine_PC1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_HYEL_120_Dual_engine_PC2, train_is_driving_backwards) {
    0: set_HYEL_120_Dual_engine_PC2;
    1: set_HYEL_120_Dual_engine_PC2_Rev;
}

// 편성그래픽
// 4량
switch (FEAT_TRAINS, SELF, sw_HYEL_120_Dual_engine_2car, position_in_vehid_chain % 2) {
    0: sw_HYEL_120_Dual_engine_PC1; //default
    1: sw_HYEL_120_Dual_engine_PC2;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_HYEL_120_Dual_engine_2car, extra_callback_info1) {
    1: HYEL_120_Dual;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }