/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Cargo_320_engineH, train_is_driving_backwards) {
    0: set_KTX_Cargo_320_engineH;
    1: set_KTX_Cargo_320_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cargo_320_panto_wagon_M1, train_is_driving_backwards) {
    0: set_KTX_Cargo_320_panto_wagon_M1;
    1: set_KTX_Cargo_320_panto_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cargo_320_panto_wagon_M4, train_is_driving_backwards) {
    0: set_KTX_Cargo_320_panto_wagon_M4;
    1: set_KTX_Cargo_320_panto_wagon_M4_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cargo_320_engineT, train_is_driving_backwards) {
    0: set_KTX_Cargo_320_engineT;
    1: set_KTX_Cargo_320_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Cargo_320_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_KTX_Cargo_320_engineT;
    sw_KTX_Cargo_320_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_KTX_Cargo_320_wagon_M3_front, position_in_vehid_chain) {
    0: sw_KTX_Cargo_320_panto_wagon_M1;
    1: set_KTX_Cargo_320_wagon_M2;
    set_KTX_Cargo_320_wagon_M3;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Cargo_320_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Cargo_320_panto_wagon_M4;
    1..2: set_KTX_Cargo_320_wagon_M2;
    sw_KTX_Cargo_320_wagon_M3_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Cargo_320_wagon, num_vehs_in_vehid_chain) {
     1..255: sw_KTX_Cargo_320_wagon_full;
    set_KTX_Cargo_320_wagon_M3;
}