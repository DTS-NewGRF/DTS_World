/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Taegeuk_engineH, train_is_driving_backwards) {
    0: set_KTX_Taegeuk_engineH;
    1: set_KTX_Taegeuk_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Taegeuk_engineT, train_is_driving_backwards) {
    0: set_KTX_Taegeuk_engineT;
    1: set_KTX_Taegeuk_engineT_Rev;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Taegeuk_12car, position_in_vehid_chain % 12) {
     0: sw_KTX_Taegeuk_engineH;
     1: set_KTX_Taegeuk_wagon_T1;
     2: set_KTX_Taegeuk_wagon_T2;
     3: set_KTX_Taegeuk_wagon_T3;
     4: set_KTX_Taegeuk_wagon_T4;
     5: set_KTX_Taegeuk_wagon_T5;
     6: set_KTX_Taegeuk_wagon_T;
     7: set_KTX_Taegeuk_wagon_T6;
     8: set_KTX_Taegeuk_wagon_T7;
     9: set_KTX_Taegeuk_wagon_T8;
    10: set_KTX_Taegeuk_wagon_T9;
    11: sw_KTX_Taegeuk_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Taegeuk_12car, extra_callback_info1) {
    1..11: KTX_Taegeuk_12Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }