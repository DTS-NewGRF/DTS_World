/*--------------------------------------------------------------------
KTX-태극
--------------------------------------------------------------------*/
// Graphics
#include "KTX_Taegeuk_graphic.pnml"

// Switch
#include "KTX_Taegeuk_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Taegeuk_engine, 1027){
    property {
        name:                           string(NAME_KTX_Taegeuk_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2130, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        dual_headed:                    1;
        
        //spec
        speed:                          600km/h;
        power:                          16000 kW;
        weight:                         90 ton;
        tractive_effort_coefficient:    0.86;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 80;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
    
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_MU,TRAIN_FLAG_AUTOREFIT);
        extra_weight_per_wagon:         35 ton;
        }
        
	graphics {
        default:                        sw_KTX_Taegeuk_engine;
        purchase:                       set_KTX_Taegeuk_engine_purchase;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_osfx_65_sound;
        }
        }

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Taegeuk_wagon, 1028){
    property {
        name:                           string(NAME_Group_KTX_Taegeuk_wagon);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  Train_Car;
        }

    graphics {
        purchase:                       set_KTX_Taegeuk_Logo_purchase;
        }
        }

