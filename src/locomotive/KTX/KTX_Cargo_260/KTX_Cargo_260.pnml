/*--------------------------------------------------------------------
KTX-이음 260
--------------------------------------------------------------------*/
// Graphics
#include "KTX_Cargo_260_graphic.pnml"

// Switch
#include "KTX_Cargo_260_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Cargo_260_engine, 1046){
    property {
        name:                           string(NAME_KTX_Cargo_260_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2024, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  KTX_Logo;
        dual_headed:                    1;
        
        //spec
        speed:                          260km/h;
        power:                          9600 kW;
        weight:                         37 ton;
        tractive_effort_coefficient:    0.579;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 90;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [MAIL, VALU, GOOD];
        cargo_disallow_refit:           [];
        
        //Costs
        cost_factor:                    10;
        running_cost_factor:            150;
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }
        
    graphics {
        default:                        sw_KTX_Cargo_260_engine;
        purchase:                       set_KTX_Cargo_260_engine_purchase;
        speed:                          sw_High_260_speed;
        loading_speed:                  25;
        sound_effect:                   sw_HYUNDAIROTEMIGBTIPM1Kstart_sound;
        }
    
    livery_override(KTX_Cargo_260_wagon) {
        default:                        sw_sw_KTX_Cargo_260_wagon;
        loading_speed:                  25;
        }
        }

/*--------------------------------------------------------------------
객차
--------------------------------------------------------------------*/
