/*--------------------------------------------------------------------
KTX-청룡
--------------------------------------------------------------------*/
// Graphics
#include "KTX_Cheong_Ryong_graphic.pnml"

// Switch
#include "KTX_Cheong_Ryong_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Cheong_Ryong, 1167){
    property {
        name:                           string(NAME_Group_KTX_Cheong_Ryong);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          2592 kW;
        variant_group:                  KTX_Logo;
        }

    graphics {
        purchase:                       set_KTX_Cheong_Ryong_Logo_purchase;
        }
        }

/*--------------------------------------------------------------------
열차정보 8량
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Cheong_Ryong_8Car, 2229){
    property {
        name:                           string(NAME_KTX_Cheong_Ryong_8Car);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2022, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  KTX_Cheong_Ryong;
        
        //spec
        speed:                          362km/h;
        power:                          14400 kW;
        weight:                         280 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 65;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        cost_factor:                    10;
        running_cost_factor:            150;
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }
        
    graphics {
        default:                        sw_KTX_Cheong_Ryong_8car;
        articulated_part:               sw_articulated_KTX_Cheong_Ryong_8car;
        purchase:                       KTX_Cheong_Ryong_purchase;
        speed:                          sw_High_320_352_speed;
        cargo_capacity:                 sw_KTX_Cheong_Ryong_capacity_in_custom;
        loading_speed:                  25;
        cargo_subtype_text:             sw_KTX_Cheong_Ryong_cargo_subtype_text;
        sound_effect:                   sw_HYUNDAIROTEMIGBTIPM1Kstart_sound;
        }
        }

