//도색명
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_KTX_Cheong_Ryong_Eum);
    1: return string(Livery_KTX_Cheong_Ryong);
    2: return string(Livery_KTX_Cheong_Ryong_2nd);
    3: return string(Livery_SRT_320);
    return CB_RESULT_NO_TEXT;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_cargo_subtype_text, cargo_subtype) {
     0: return string(Livery_KTX_Cheong_Ryong_Eum);
     1: return string(Livery_KTX_Cheong_Ryong);
     2: return string(Livery_KTX_Cheong_Ryong_2nd);
     3: return string(Livery_SRT_320);
     4: return string(Livery_KTX_Cheong_Ryong_BK);
     5: return string(Livery_KTX_Cheong_Ryong_CC);
     6: return string(Livery_KTX_Cheong_Ryong_Euro);
     7: return string(Livery_KTX_Cheong_Ryong_ICE);
     8: return string(Livery_KTX_Cheong_Ryong_JR);
     9: return string(Livery_KTX_Cheong_Ryong_SRT_A);
    10: return string(Livery_KTX_Cheong_Ryong_SRT_B);
    11: return string(Livery_KTX_Cheong_Ryong_SRT_C);
    12: return string(Livery_KTX_Cheong_Ryong_SRT_D);
    13: return string(Livery_KTX_Cheong_Ryong_SRT_E);
    14: return string(Livery_KTX_Cheong_Ryong_THRS);
    return CB_RESULT_NO_TEXT;
}

