    1: sw_KTX_Cheong_Ryong_Fixed_panto_wagon_M4_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Fixed_engineT, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_Fixed_engineT_Front;
    1: sw_KTX_Cheong_Ryong_Fixed_engineT_Back;
}

// 자유편성
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_engineH, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_Free_engineH_Front;
    1: sw_KTX_Cheong_Ryong_Free_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_panto_wagon_M1, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_Free_panto_wagon_M1_Front;
    1: sw_KTX_Cheong_Ryong_Free_panto_wagon_M1_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_panto_wagon_M4, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_Free_panto_wagon_M4_Front;
    1: sw_KTX_Cheong_Ryong_Free_panto_wagon_M4_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_engineT, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_Free_engineT_Front;
    1: sw_KTX_Cheong_Ryong_Free_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_KTX_Cheong_Ryong_Free_engineT;
    sw_KTX_Cheong_Ryong_Free_engineH;
}

// 객차
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_order_wagon, position_in_consist % 2) {
    1: sw_KTX_Cheong_Ryong_Free_wagon_M3;
    sw_KTX_Cheong_Ryong_Free_wagon_M31;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_wagon_front, position_in_vehid_chain) {
    0: sw_KTX_Cheong_Ryong_Free_panto_wagon_M1;
    1: sw_KTX_Cheong_Ryong_Free_wagon_M21;
    sw_KTX_Cheong_Ryong_order_wagon;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Cheong_Ryong_Free_panto_wagon_M4;
    1: sw_KTX_Cheong_Ryong_Free_wagon_M2;
    2: sw_KTX_Cheong_Ryong_Free_wagon_M22;
    sw_KTX_Cheong_Ryong_Free_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Free_wagon, num_vehs_in_vehid_chain) {
     1..255: sw_KTX_Cheong_Ryong_Free_wagon_full;
    sw_KTX_Cheong_Ryong_order_wagon;
}

// 편성그래픽
// 8량
switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_8car, position_in_vehid_chain % 8) {
    0: sw_KTX_Cheong_Ryong_Fixed_engineH; //default
    1: sw_KTX_Cheong_Ryong_Fixed_panto_wagon_M1;
    2: sw_KTX_Cheong_Ryong_Fixed_wagon_M21;
    3: sw_KTX_Cheong_Ryong_Fixed_wagon_M3;
    4: sw_KTX_Cheong_Ryong_Fixed_wagon_M22;
    5: sw_KTX_Cheong_Ryong_Fixed_wagon_M2;
    6: sw_KTX_Cheong_Ryong_Fixed_panto_wagon_M4;
    7: sw_KTX_Cheong_Ryong_Fixed_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_8car, extra_callback_info1) {
    1..7: KTX_Cheong_Ryong_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

// 수송량
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_capacity_in_custom, cargo_subtype) {
    0: return 65;
    1: return 61;
    2..3: return 63;
    4..14: return 61;
}