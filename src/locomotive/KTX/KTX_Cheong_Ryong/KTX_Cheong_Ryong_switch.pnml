//도색명
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_cargo_subtype_text, cargo_subtype) {
     0: return string(Livery_KTX_Cheong_Ryong_Eum);
     1: return string(Livery_KTX_Cheong_Ryong);
     2: return string(Livery_KTX_Cheong_Ryong_2nd);
     3: return string(Livery_SRT_320);
     4: return string(Livery_KTX_Cheong_Ryong_BK);
     5: return string(Livery_KTX_Cheong_Ryong_CC);
     6: return string(Livery_KTX_Cheong_Ryong_SRT_A);
     7: return string(Livery_KTX_Cheong_Ryong_SRT_B);
     8: return string(Livery_KTX_Cheong_Ryong_SRT_C);
     9: return string(Livery_KTX_Cheong_Ryong_SRT_D);
    10: return string(Livery_KTX_Cheong_Ryong_SRT_E);
    return CB_RESULT_NO_TEXT;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Export_8Car_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_KTX_Cheong_Ryong_ICE);
    1: return string(Livery_KTX_Cheong_Ryong_JR);
