switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Export_16Car_engineT, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_Export_16Car_engineT_Front;
    1: sw_KTX_Cheong_Ryong_Export_16Car_engineT_Back;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_8car, position_in_vehid_chain % 8) {
    0: sw_KTX_Cheong_Ryong_engineH; //default
    1: sw_KTX_Cheong_Ryong_panto_wagon_M1;
    2: sw_KTX_Cheong_Ryong_wagon_M21;
    3: sw_KTX_Cheong_Ryong_wagon_M3;
    4: sw_KTX_Cheong_Ryong_wagon_M22;
    5: sw_KTX_Cheong_Ryong_wagon_M2;
    6: sw_KTX_Cheong_Ryong_panto_wagon_M4;
    7: sw_KTX_Cheong_Ryong_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Export_8Car, position_in_vehid_chain % 8) {
    0: sw_KTX_Cheong_Ryong_Export_8Car_engineH; //default
    1: sw_KTX_Cheong_Ryong_Export_8Car_panto_wagon_M1;
    2: sw_KTX_Cheong_Ryong_Export_8Car_wagon_M2;
    3: sw_KTX_Cheong_Ryong_Export_8Car_wagon_M3;
    4..5: sw_KTX_Cheong_Ryong_Export_8Car_wagon_M2;
    6: sw_KTX_Cheong_Ryong_Export_8Car_panto_wagon_M4;
    7: sw_KTX_Cheong_Ryong_Export_8Car_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_THSR_12Car, position_in_vehid_chain % 12) {
     0: sw_KTX_Cheong_Ryong_THSR_engineH; //default
     1: sw_KTX_Cheong_Ryong_THSR_wagon_M1;
     2: set_KTX_Cheong_Ryong_THSR_wagon_M2;
     3..4: set_KTX_Cheong_Ryong_THSR_wagon_M3;
     5..6: set_KTX_Cheong_Ryong_THSR_wagon_M2;
     7..8: set_KTX_Cheong_Ryong_THSR_wagon_M3;
     9: set_KTX_Cheong_Ryong_THSR_wagon_M2;
    10: sw_KTX_Cheong_Ryong_THSR_wagon_M4;
    11: sw_KTX_Cheong_Ryong_THSR_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_Export_16Car, position_in_vehid_chain % 16) {
     0: sw_KTX_Cheong_Ryong_Export_16Car_engineH; //default
     1: sw_KTX_Cheong_Ryong_Export_16Car_panto_wagon_M1;
     2: sw_KTX_Cheong_Ryong_Export_16Car_wagon_M2;
     3..6: sw_KTX_Cheong_Ryong_Export_16Car_wagon_M3;
     7..8: sw_KTX_Cheong_Ryong_Export_16Car_wagon_M2;
     9..12: sw_KTX_Cheong_Ryong_Export_16Car_wagon_M3;
    13: sw_KTX_Cheong_Ryong_Export_16Car_wagon_M2;
    14: sw_KTX_Cheong_Ryong_Export_16Car_panto_wagon_M4;
    15: sw_KTX_Cheong_Ryong_Export_16Car_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_8car, extra_callback_info1) {
    1..7: KTX_Cheong_Ryong_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_Export_8Car, extra_callback_info1) {
    1..7: KTX_Cheong_Ryong_Export_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_THSR_12Car, extra_callback_info1) {
    1..11: KTX_Cheong_Ryong_Export_12Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_Export_16Car, extra_callback_info1) {
    1..15: KTX_Cheong_Ryong_Export_16Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

// 수송량
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_capacity_in_custom, cargo_subtype) {
    0: return 65;
    1: return 61;
    2..3: return 63;
    4..10: return 61;
}