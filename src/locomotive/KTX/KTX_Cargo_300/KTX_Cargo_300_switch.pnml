/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Cargo_300_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: set_KTX_Cargo_300_engineT;
    set_KTX_Cargo_300_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_CTX_Free_wagon_front, position_in_vehid_chain) {
    0: set_CTX_wagon_T1;
    set_CTX_wagon_T2;
}

switch (FEAT_TRAINS, SELF, sw_CTX_Free_wagon_back, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: set_CTX_wagon_T4;
    set_CTX_wagon_T3;
}

switch (FEAT_TRAINS, SELF, sw_CTX_Free_wagon, position_in_vehid_chain * 2 < num_vehs_in_vehid_chain) {
    1: sw_CTX_Free_wagon_front;
    sw_CTX_Free_wagon_back;
}