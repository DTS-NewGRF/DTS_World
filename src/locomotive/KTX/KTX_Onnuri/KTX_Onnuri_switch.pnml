/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Onnuri_engineH, train_is_driving_backwards) {
    0: set_KTX_Onnuri_engineH;
    1: set_KTX_Onnuri_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Onnuri_wagon_M1, train_is_driving_backwards) {
    0: set_KTX_Onnuri_wagon_M1;
    1: set_KTX_Onnuri_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Onnuri_wagon_M4, train_is_driving_backwards) {
    0: set_KTX_Onnuri_wagon_M4;
    1: set_KTX_Onnuri_wagon_M4_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Onnuri_engineT, train_is_driving_backwards) {
    0: set_KTX_Onnuri_engineT;
    1: set_KTX_Onnuri_engineT_Rev;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Onnuri_8car, position_in_vehid_chain % 8) {
    0: sw_KTX_Onnuri_engineH; //default
    1: sw_KTX_Onnuri_wagon_M1;
    2: set_KTX_Onnuri_wagon_M2;
    3: set_KTX_Onnuri_wagon_M3;
    4: set_KTX_Onnuri_wagon_M2;
    5: set_KTX_Onnuri_wagon_M2;
    6: sw_KTX_Onnuri_wagon_M4;
    7: sw_KTX_Onnuri_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_KTX_Onnuri_10car, position_in_vehid_chain % 10) {
    0: sw_KTX_Onnuri_engineH; //default
    1: sw_KTX_Onnuri_wagon_M1;
    2: set_KTX_Onnuri_wagon_M2;
    3: set_KTX_Onnuri_wagon_M3_Only_10Car;
    4: set_KTX_Onnuri_wagon_DUP1;
    5: set_KTX_Onnuri_wagon_DUP2;
    6: set_KTX_Onnuri_wagon_M2;
    7: set_KTX_Onnuri_wagon_M2;
    8: sw_KTX_Onnuri_wagon_M4;
    9: sw_KTX_Onnuri_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Onnuri_8car, extra_callback_info1) {
    1..7: KTX_Onnuri_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Onnuri_10car, extra_callback_info1) {
    1..9: KTX_Onnuri_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }