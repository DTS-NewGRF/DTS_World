/*--------------------------------------------------------------------
KTX-온누리
--------------------------------------------------------------------*/
// Graphics
#include "KTX_Onnuri_graphic.pnml"

// Switch
#include "KTX_Onnuri_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Onnuri, 1173){
    property {
        name:                           string(NAME_Group_KTX_Onnuri);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          2592 kW;
        variant_group:                  KTX_Logo;
        }

    graphics {
        purchase:                       set_KTX_Onnuri_Logo_purchase;
        }
        }

/*--------------------------------------------------------------------
열차정보
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Onnuri_8Car, 1174){
    property {
        name:                           string(NAME_KTX_Onnuri_8Car);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2032, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  KTX_Onnuri;
        
        //spec
        speed:                          370km/h;
        power:                          13800 kW;
        weight:                         28 ton;
        tractive_effort_coefficient:    0.775;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 58;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

    graphics {
        default:                        sw_KTX_Onnuri_8car;
        articulated_part:               sw_articulated_KTX_Onnuri_8car;
        purchase:                       set_KTX_Onnuri_purchase;
        speed:                          sw_High_370_400_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_TOSHIBASicStart_sound;
        }
        }

