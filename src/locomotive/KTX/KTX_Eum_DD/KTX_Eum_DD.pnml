/*--------------------------------------------------------------------
KTX-이음 DD
--------------------------------------------------------------------*/
// Graphics
#include "KTX_Eum_DD_graphic.pnml"

// Switch
#include "KTX_Eum_DD_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Eum_DD_6Car, 1164){
    property {
        name:                           string(NAME_KTX_Eum_DD_6Car);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2032, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  KTX_Logo;
        
        //spec
        speed:                          260km/h;
        power:                          18224 kW;
        weight:                         350 ton;
        tractive_effort_coefficient:    0.579;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        visual_effect_and_powered:      VISUAL_EFFECT_DISABLE;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 90;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        cost_factor:                    10;
        running_cost_factor:            150;
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }
        
    graphics {
        default:                        sw_KTX_Eum_DD_6car;
        articulated_part:               sw_articulated_KTX_Eum_DD_6car;
        purchase:                       set_KTX_Eum_DD_purchase;
        speed:                          sw_High_260_286_speed;
        loading_speed:                  25;
        sound_effect:                   sw_HYUNDAIROTEMIGBTIPM1Kstart_sound;
        }
        }

