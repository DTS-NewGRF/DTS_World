/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_DD_engineH, train_is_driving_backwards) {
    0: set_KTX_Eum_DD_engineH;
    1: set_KTX_Eum_DD_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_DD_wagon_M1, train_is_driving_backwards) {
    0: set_KTX_Eum_DD_wagon_M1;
    1: set_KTX_Eum_DD_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_DD_wagon_M3, train_is_driving_backwards) {
    0: set_KTX_Eum_DD_wagon_M3;
    1: set_KTX_Eum_DD_wagon_M3_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_DD_engineT, train_is_driving_backwards) {
    0: set_KTX_Eum_DD_engineT;
    1: set_KTX_Eum_DD_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_DD_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_KTX_Eum_DD_engineT;
    sw_KTX_Eum_DD_engineH;
}

// 객차
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_DD_wagon_M2, position_in_consist % 2) {
    1: set_KTX_Eum_DD_wagon_M2_1;
    set_KTX_Eum_DD_wagon_M2;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Eum_DD_wagon_front, position_in_vehid_chain) {
    0: sw_KTX_Eum_DD_wagon_M1;
    sw_KTX_Eum_DD_wagon_M2;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Eum_DD_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Eum_DD_wagon_M3;
    sw_KTX_Eum_DD_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Eum_wagon, num_vehs_in_vehid_chain) {
    1..255: sw_KTX_Eum_DD_wagon_full;
    sw_KTX_Eum_DD_wagon_M2;
}

