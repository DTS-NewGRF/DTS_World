    3: set_KTX_1_wagon_T4;    
}

switch(FEAT_TRAINS, SELF, sw_KTX_1_wagon_T3_6Car, cargo_subtype) {
    0..1: set_KTX_1_wagon_T3;
    2: set_KTX_1_LTE_A_wagon_T3;
    3: set_KTX_1_wagon_T6;    
}

switch(FEAT_TRAINS, SELF, sw_KTX_1_wagon_T5, cargo_subtype) {
    0..1: set_KTX_1_wagon_T5;
    2: set_KTX_1_LTE_A_wagon_T5;
    3: set_KTX_1_wagon_T5;    
}

switch(FEAT_TRAINS, SELF, sw_KTX_1_wagon_T6, cargo_subtype) {
    0..1: set_KTX_1_wagon_T6;
