// 도색명
switch(FEAT_TRAINS, SELF, sw_KTX_1_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_KTX_1_1997);
    1: return string(Livery_KTX_1_2007);
    2: return string(Livery_KTX_1_2013);
    3: return string(Livery_KTX_1_2017);
    return CB_RESULT_NO_TEXT;
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_KTX_1_engineH_Front, cargo_subtype) {
    0..2: set_KTX_1_engineH;
    2: set_KTX_1_LTE_A_engineH;
    3: set_KTX_1_engineH;
}

switch(FEAT_TRAINS, SELF, sw_KTX_1_wagon_T1, cargo_subtype) {
    0: set_KTX_1_wagon_T1;
    1: set_KTX_1M_wagon_T1;
    2: set_KTX_1_LTE_A_wagon_T1;
    3: set_KTX_1_wagon_T1;    
}

