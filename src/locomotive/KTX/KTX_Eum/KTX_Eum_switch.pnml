//도색명
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_KTX_Eum);
    1: return string(Livery_KTX_Eum_2nd);
    return CB_RESULT_NO_TEXT;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Free_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_KTX_Eum);
    1: return string(Livery_KTX_Eum_2nd);
    2: return string(Livery_KTX_Eum_MD);
    3: return string(Livery_KTX_Eum_W);
    4: return string(Livery_KTX_Eum_BK);
    5: return string(Livery_KTX_Eum_SM1);
    6: return string(Livery_KTX_Eum_SM2);
    7: return string(Livery_KTX_Eum_SM3);
    return CB_RESULT_NO_TEXT;
}

// 도색그래픽 세팅
// 고정열차
// 전진방향
switch(FEAT_TRAINS, SELF, set_KTX_Eum_Fixed_engineH_Front, cargo_subtype) {
    0: set_KTX_Eum_engineH;
    1: set_KTX_Eum_2nd_engineH;
}

