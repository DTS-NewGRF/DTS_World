    0: set_KTX_Eum_panto_wagon_M1;
    1: set_KTX_Eum_2nd_panto_wagon_M1;
    2: set_KTX_Eum_MD_wagon_M1;
    3: set_KTX_Eum_W_wagon_M1;
    4: set_KTX_Eum_BK_wagon_M1;
    5: set_KTX_Eum_SM1_wagon_M1;
