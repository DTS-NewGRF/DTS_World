    0: set_KTX_Eum_panto_wagon_M4_Rev;
    1: set_KTX_Eum_2nd_panto_wagon_M4_Rev;
    2: set_KTX_Eum_MD_wagon_M3_Rev;
    3: set_KTX_Eum_W_wagon_M3_Rev;
    4: set_KTX_Eum_BK_wagon_M3_Rev;
    5: set_KTX_Eum_SM1_wagon_M3_Rev;
