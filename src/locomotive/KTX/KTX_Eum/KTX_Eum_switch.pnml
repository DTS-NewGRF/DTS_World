    6: set_KTX_Eum_SM2_engineH_Rev;
    7: set_KTX_Eum_SM3_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_panto_wagon_M1_Back, cargo_subtype) {
    0: set_KTX_Eum_panto_wagon_M1_Rev;
    1: set_KTX_Eum_2nd_panto_wagon_M1_Rev;
    2: set_KTX_Eum_MD_wagon_M1_Rev;
    3: set_KTX_Eum_W_wagon_M1_Rev;
    4: set_KTX_Eum_BK_wagon_M1_Rev;
    5: set_KTX_Eum_SM1_wagon_M1_Rev;
    6: set_KTX_Eum_SM2_wagon_M1_Rev;
