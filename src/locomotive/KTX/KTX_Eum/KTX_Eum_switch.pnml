    3: set_KTX_Eum_W_wagon_M2;
    4: set_KTX_Eum_BK_wagon_M2;
    5: set_KTX_Eum_SM1_wagon_M2;
    6: set_KTX_Eum_SM2_wagon_M2;
    7: set_KTX_Eum_SM3_wagon_M2;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_panto_wagon_M4_Front, cargo_subtype) {
    0: set_KTX_Eum_panto_wagon_M4;
    1: set_KTX_Eum_2nd_panto_wagon_M4;
    2: set_KTX_Eum_MD_wagon_M3;
