    7: set_KTX_Eum_SM3_engineT_Rev;    
}

// 전후진 통합 코드
// 고정편성
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Fixed_engineH, train_is_driving_backwards) {
    0: set_KTX_Eum_Fixed_engineH_Front;
    1: set_KTX_Eum_Fixed_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Fixed_panto_wagon_M1, train_is_driving_backwards) {
    0: sw_KTX_Eum_Fixed_panto_wagon_M1_Front;
    1: sw_KTX_Eum_Fixed_panto_wagon_M1_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Fixed_panto_wagon_M3, train_is_driving_backwards) {
    0: sw_KTX_Eum_Fixed_panto_wagon_M3_Front;
    1: sw_KTX_Eum_Fixed_panto_wagon_M3_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Fixed_engineT, train_is_driving_backwards) {
    0: sw_KTX_Eum_Fixed_engineT_Front;
    1: sw_KTX_Eum_Fixed_engineT_Back;
}

// 자유편성
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Free_engineH, train_is_driving_backwards) {
    0: set_KTX_Eum_Free_engineH_Front;
    1: set_KTX_Eum_Free_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Free_panto_wagon_M1, train_is_driving_backwards) {
    0: sw_KTX_Eum_Free_panto_wagon_M1_Front;
    1: sw_KTX_Eum_Free_panto_wagon_M1_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Free_panto_wagon_M3, train_is_driving_backwards) {
    0: sw_KTX_Eum_Free_panto_wagon_M3_Front;
    1: sw_KTX_Eum_Free_panto_wagon_M3_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Free_engineT, train_is_driving_backwards) {
    0: sw_KTX_Eum_Free_engineT_Front;
    1: sw_KTX_Eum_Free_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_Free_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_KTX_Eum_Free_engineT;
    sw_KTX_Eum_Free_engineH;
}

// 객차
// 자유객차
switch (FEAT_TRAINS, SELF, sw_KTX_Eum_Free_wagon_front, position_in_vehid_chain) {
    0: sw_KTX_Eum_Free_panto_wagon_M1;
    sw_KTX_Eum_Free_wagon_M2;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Eum_Free_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Eum_Free_panto_wagon_M3;
    sw_KTX_Eum_Free_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Eum_Free_wagon, num_vehs_in_vehid_chain) {
     1..255: sw_KTX_Eum_Free_wagon_full;
    sw_KTX_Eum_Free_wagon_M2;
}

// 고정편성 그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Eum_6car, position_in_vehid_chain % 6) {
    0: sw_KTX_Eum_Fixed_engineH; //default
    1: sw_KTX_Eum_Fixed_panto_wagon_M1;
    2..3: sw_KTX_Eum_Fixed_wagon_M2;
    4: sw_KTX_Eum_Fixed_panto_wagon_M3;
    5: sw_KTX_Eum_Fixed_engineT;
    }

// 12량
switch (FEAT_TRAINS, SELF, sw_KTX_Eum_12car, position_in_vehid_chain % 12) {
    0: set_Deleted_A; //default
    1..11: set_Deleted_B;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Eum_6car, extra_callback_info1) {
    1..5: KTX_Eum_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Eum_12car, extra_callback_info1) {
    1..11: KTX_Eum_12Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }