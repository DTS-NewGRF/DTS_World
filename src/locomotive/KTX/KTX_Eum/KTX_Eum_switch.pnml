    7: set_KTX_Eum_SM3_wagon_M3_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_engineT_Back, cargo_subtype) {
    0: set_KTX_Eum_engineT_Rev;
    1: set_KTX_Eum_2nd_engineT_Rev;
    2: set_KTX_Eum_MD_engineT_Rev;
    3: set_KTX_Eum_W_engineT_Rev;
    4: set_KTX_Eum_BK_engineT_Rev;
    5: set_KTX_Eum_SM1_engineT_Rev;
    6: set_KTX_Eum_SM2_engineT_Rev;
    7: set_KTX_Eum_SM3_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Eum_engineH, train_is_driving_backwards) {
    0: set_KTX_Eum_engineH_Front;
    1: set_KTX_Eum_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_panto_wagon_M1, train_is_driving_backwards) {
    0: sw_KTX_Eum_panto_wagon_M1_Front;
    1: sw_KTX_Eum_panto_wagon_M1_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_panto_wagon_M4, train_is_driving_backwards) {
    0: sw_KTX_Eum_panto_wagon_M4_Front;
    1: sw_KTX_Eum_panto_wagon_M4_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_engineT, train_is_driving_backwards) {
    0: sw_KTX_Eum_engineT_Front;
    1: sw_KTX_Eum_engineT_Back;
}

// 고정편성 그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Eum_6car, position_in_vehid_chain % 6) {
    0: sw_KTX_Eum_engineH; //default
    1: sw_KTX_Eum_panto_wagon_M1;
    2..3: sw_KTX_Eum_wagon_M2;
    4: sw_KTX_Eum_panto_wagon_M4;
    5: sw_KTX_Eum_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Eum_6car, extra_callback_info1) {
    1..5: KTX_Eum_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }