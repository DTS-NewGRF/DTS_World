    6: set_KTX_Eum_SM2_wagon_M3;
    7: set_KTX_Eum_SM3_wagon_M3;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Eum_engineT_Front, cargo_subtype) {
    0: set_KTX_Eum_engineT;
    1: set_KTX_Eum_2nd_engineT;
    2: set_KTX_Eum_MD_engineT;
    3: set_KTX_Eum_W_engineT;
    4: set_KTX_Eum_BK_engineT;
    5: set_KTX_Eum_SM1_engineT;
    6: set_KTX_Eum_SM2_engineT;
    7: set_KTX_Eum_SM3_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, set_KTX_Eum_engineH_Back, cargo_subtype) {
    0: set_KTX_Eum_engineH_Rev;
    1: set_KTX_Eum_2nd_engineH_Rev;
    2: set_KTX_Eum_MD_engineH_Rev;
    3: set_KTX_Eum_W_engineH_Rev;
    4: set_KTX_Eum_BK_engineH_Rev;
