/*--------------------------------------------------------------------
KTX-산천 C
--------------------------------------------------------------------*/
// Graphics
#include "KTX_Sancheon_C_graphic.pnml"

// Switch
#include "KTX_Sancheon_C_switch.pnml"

/*--------------------------------------------------------------------
열차정보 화물전용
--------------------------------------------------------------------*/
item(FEAT_TRAINS, KTX_Sancheon_C_engine, 1048){
    property {
        name:                           string(NAME_KTX_Sancheon_C_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2020, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  KTX_Logo;
        
        //spec
        speed:                          300km/h;
        power:                          8800 kW;
        weight:                         37 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 1;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [MAIL, VALU];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_DIESEL;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

	graphics {
        default:                        sw_KTX_Sancheon_C_engine;
        purchase:                       set_KTX_Sancheon_C_purchase;
        speed:                          sw_High_305_330_speed;
        cargo_capacity:                 0;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_KTXSCstart_sound;
        }
        }

