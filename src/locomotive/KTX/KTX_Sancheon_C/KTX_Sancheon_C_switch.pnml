/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_C_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    0: set_KTX_Sancheon_C_engineH;
    1: set_KTX_Sancheon_C_engineT;
}

// 고정편성 그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_C_wagon_4car, position_in_vehid_chain % 4) {
    0: set_KTX_Sancheon_C_wagon_T1;
    1: set_KTX_Sancheon_C_wagon_T2;
    2: set_KTX_Sancheon_C_wagon_T3;
    3: set_KTX_Sancheon_C_wagon_T4;
    }

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_C_wagon_8car, position_in_vehid_chain % 8) {
    0: set_KTX_Sancheon_C_wagon_T1;
    1..3: set_KTX_Sancheon_C_wagon_T2;
    4..6: set_KTX_Sancheon_C_wagon_T3;
    7: set_KTX_Sancheon_C_wagon_T4;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Sancheon_C_wagon_4car, extra_callback_info1) {
    1..3: KTX_Sancheon_C_wagon_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Sancheon_C_wagon_8car, extra_callback_info1) {
    1..7: KTX_Sancheon_C_wagon_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }