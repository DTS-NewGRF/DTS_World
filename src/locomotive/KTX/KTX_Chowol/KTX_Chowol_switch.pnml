/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Chowol_engineH, train_is_driving_backwards) {
    0: set_KTX_Chowol_engineH;
    1: set_KTX_Chowol_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Chowol_wagon_M1, train_is_driving_backwards) {
    0: set_KTX_Chowol_wagon_M1;
    1: set_KTX_Chowol_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Chowol_wagon_M4, train_is_driving_backwards) {
    0: set_KTX_Chowol_wagon_M4;
    1: set_KTX_Chowol_wagon_M4_Rev;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Chowol_engineT, train_is_driving_backwards) {
    0: set_KTX_Chowol_engineT;
    1: set_KTX_Chowol_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Chowol_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_KTX_Chowol_engineT;
    sw_KTX_Chowol_engineH;
}

// 자유객차
// 1층
switch (FEAT_TRAINS, SELF, sw_KTX_Chowol_wagon_front, position_in_vehid_chain) {
    0: sw_KTX_Chowol_wagon_M1;
    1: set_KTX_Chowol_wagon_M3;
    set_KTX_Chowol_wagon_M2;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Chowol_wagon_back, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Chowol_wagon_M4;
    set_KTX_Chowol_wagon_M2;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Chowol_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Chowol_wagon_back;
    sw_KTX_Chowol_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Chowol_wagon, num_vehs_in_vehid_chain) {
    1..255: sw_KTX_Chowol_wagon_full;
    set_KTX_Chowol_wagon_M2;
}

// 2층
switch(FEAT_TRAINS, SELF, sw_KTX_Chowol_DUP_wagon, position_in_consist % 2) {
    1: set_KTX_Chowol_wagon_DUP2;
    set_KTX_Chowol_wagon_DUP1;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Chowol_DD_order_wagon, position_in_consist % 2) {
    0: set_KTX_Chowol_wagon_DUP2;
    set_KTX_Chowol_wagon_DUP1;
}