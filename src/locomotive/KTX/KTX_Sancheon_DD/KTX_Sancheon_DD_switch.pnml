/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 자유객차
switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_DD_wagon_front, position_in_vehid_chain) {
    0: set_KTX_Sancheon_DD_wagon_T1;
    1: set_KTX_Sancheon_DD_wagon_T2;
    2: set_KTX_Sancheon_DD_wagon_T3;
    3: set_KTX_Sancheon_DD_wagon_T2;
    set_KTX_Sancheon_DD_wagon_T4;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_DD_wagon_back, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: set_KTX_Sancheon_DD_wagon_T5;
    set_KTX_Sancheon_DD_wagon_T4;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_DD_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0..1: sw_KTX_Sancheon_DD_wagon_back;
    sw_KTX_Sancheon_DD_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_DD_wagon, num_vehs_in_vehid_chain) {
     1..255: sw_KTX_Sancheon_DD_wagon_full;
    set_KTX_Sancheon_DD_wagon_T4;
}