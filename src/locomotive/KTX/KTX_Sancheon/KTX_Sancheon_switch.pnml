// 전후진 통합 코드
// 고정편성
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_Fixed_engineH, train_is_driving_backwards) {
    0: sw_KTX_Sancheon_Fixed_engineH_Front;
    1: sw_KTX_Sancheon_Fixed_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_Fixed_engineT, train_is_driving_backwards) {
    0: sw_KTX_Sancheon_Fixed_engineT_Front;
    1: sw_KTX_Sancheon_Fixed_engineT_Back;
}

// 자유편성
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_Free_engineH, train_is_driving_backwards) {
    0: sw_KTX_Sancheon_Free_engineH_Front;
    1: sw_KTX_Sancheon_Free_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_Free_engineT, train_is_driving_backwards) {
    0: sw_KTX_Sancheon_Free_engineT_Front;
    1: sw_KTX_Sancheon_Free_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_Free_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_KTX_Sancheon_Free_engineT;
    sw_KTX_Sancheon_Free_engineH;
}

// 객차
// 자유객차
switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_Free_wagon_front, position_in_vehid_chain) {
    0: sw_KTX_Sancheon_Free_wagon_T1;
    1: sw_KTX_Sancheon_Free_wagon_T2;
    2: sw_KTX_Sancheon_Free_wagon_T3;
    3: sw_KTX_Sancheon_Free_wagon_T4;
    sw_KTX_Sancheon_Free_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_Free_wagon_back, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Sancheon_Free_wagon_8Car;
    1: sw_KTX_Sancheon_Free_wagon_7Car;
    sw_KTX_Sancheon_Free_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_Free_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0..1: sw_KTX_Sancheon_Free_wagon_back;
    sw_KTX_Sancheon_Free_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_Free_wagon, num_vehs_in_vehid_chain) {
     1..255: sw_KTX_Sancheon_Free_wagon_full;
    sw_KTX_Sancheon_Free_wagon_T5;
}

// 그외 객차
switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_order_wagon_front, position_in_vehid_chain) {
    0: sw_KTX_Sancheon_Free_wagon_T2;
    1: sw_KTX_Sancheon_Free_wagon_T3;
    2: sw_KTX_Sancheon_Free_wagon_T4;
    sw_KTX_Sancheon_Free_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_order_wagon_back, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_KTX_Sancheon_Free_wagon_7Car;
    sw_KTX_Sancheon_Free_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_order_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0..1: sw_KTX_Sancheon_order_wagon_back;
    sw_KTX_Sancheon_order_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_order_wagon, num_vehs_in_vehid_chain) {
     1..255: sw_KTX_Sancheon_order_wagon_full;
    sw_KTX_Sancheon_Free_wagon_T5;
}

// 고정편성 그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Sancheon_10car, position_in_vehid_chain % 10) {
    0: sw_KTX_Sancheon_Fixed_engineH; //default
    1: sw_KTX_Sancheon_Fixed_wagon_T1;
    2: sw_KTX_Sancheon_Fixed_wagon_T2;
    3: sw_KTX_Sancheon_Fixed_wagon_T3;
    4: sw_KTX_Sancheon_Fixed_wagon_T4;
    5..6: sw_KTX_Sancheon_Fixed_wagon_T5;
    7: sw_KTX_Sancheon_Fixed_wagon_7Car;
    8: sw_KTX_Sancheon_Fixed_wagon_8Car;
    9: sw_KTX_Sancheon_Fixed_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Sancheon_10car, extra_callback_info1) {
    1..9: KTX_Sancheon_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

// 길이
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_length_in_custom, position_in_vehid_chain % 10) {
    0..1: 8; //default;
    2..7: 7;
    8..9: 8;
}

// 자유 객차 길이
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_length_in_custom_back, position_in_consist_from_end) {
    1: 8;
    7;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_wagon_Free_length_in_custom, position_in_consist) {
    1: 8;
    sw_KTX_Sancheon_wagon_length_in_custom_back;
}

// 수송량
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_capacity_in_custom, cargo_subtype) {
    0..3: return 38;
    4..6: return 41;
}

// 사운드
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_10Car_sound, cargo_subtype) {
    0: sw_KTXSCstart_sound;    // KTX-산천 A타입 초기분
    1: sw_KTXSCstart_sound; // KTX-산천 A타입 후기분
    2: sw_KTXSCstart_sound; // KTX-산천 120000호대 시안 1안
    3: sw_KTXSCstart_sound; // SRT 2cc
    4: sw_KTXSC140000start_sound; // KTX-산천 B타입
    5: sw_KTXSC140000start_sound; // KTX-산천 B타입 평창올림픽
}