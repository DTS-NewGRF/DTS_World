// 도색명
switch(FEAT_TRAINS, SELF, sw_KTX_Sancheon_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_KTX_Sancheon_A1);
    1: return string(Livery_KTX_Sancheon_A2);
    2: return string(Livery_SRT);
    3: return string(Livery_SRT_2cc);
    4: return string(Livery_KTX_Sancheon_B);
    5: return string(Livery_KTX_Sancheon_BP);
    6: return string(Livery_KTX_Honam_Sky_blue);
    7: return string(Livery_KTX_Honam_Yellow);
    8: return string(Livery_KTX_Gyeonggang_Blue);
    9: return string(Livery_KTX_Gyeonggang_White);
}

