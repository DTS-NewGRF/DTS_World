    1: set_KTX_Cheong_Ryong_DD_2nd_wagon_M3;
    2: set_KTX_Cheong_Ryong_DD_BK_wagon_M3;
    3: set_KTX_Cheong_Ryong_DD_CC_wagon_M3;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_wagon_M4_Front, cargo_subtype) {
    0: set_KTX_Cheong_Ryong_DD_wagon_M4;
    1: set_KTX_Cheong_Ryong_DD_2nd_wagon_M4;
    2: set_KTX_Cheong_Ryong_DD_BK_wagon_M4;
