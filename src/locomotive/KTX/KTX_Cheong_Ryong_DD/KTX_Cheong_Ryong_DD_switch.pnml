}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_engineH_Back, cargo_subtype) {
    0: set_KTX_Cheong_Ryong_DD_engineH_Rev;
    1: set_KTX_Cheong_Ryong_DD_2nd_engineH_Rev;
    2: set_KTX_Cheong_Ryong_DD_BK_engineH_Rev;
