    3: set_KTX_Cheong_Ryong_DD_CC_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_engineH, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_DD_engineH_Front;
    1: sw_KTX_Cheong_Ryong_DD_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_wagon_M1, train_is_driving_backwards) {
    0: sw_KTX_Cheong_Ryong_DD_wagon_M1_Front;
    1: sw_KTX_Cheong_Ryong_DD_wagon_M1_Back;
}

switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_wagon_M4, train_is_driving_backwards) {
