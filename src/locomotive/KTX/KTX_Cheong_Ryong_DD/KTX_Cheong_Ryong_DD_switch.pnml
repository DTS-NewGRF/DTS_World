// 도색명
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_KTX_Cheong_Ryong_DD);
    1: return string(Livery_KTX_Cheong_Ryong_DD_2nd);
    2: return string(Livery_KTX_Cheong_Ryong_DD_BK);
    3: return string(Livery_KTX_Cheong_Ryong_DD_CC);
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_engineH_Front, cargo_subtype) {
