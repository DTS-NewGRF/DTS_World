    1: sw_KTX_Cheong_Ryong_DD_engineT_Back;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_KTX_Cheong_Ryong_DD_8car, position_in_vehid_chain % 8) {
    0: sw_KTX_Cheong_Ryong_DD_engineH; //default
    1: sw_KTX_Cheong_Ryong_DD_wagon_M1;
    2: sw_KTX_Cheong_Ryong_DD_wagon_M2;
    3: sw_KTX_Cheong_Ryong_DD_wagon_M3;
    4: sw_KTX_Cheong_Ryong_DD_wagon_M2;
    5: sw_KTX_Cheong_Ryong_DD_wagon_M2_1;
    6: sw_KTX_Cheong_Ryong_DD_wagon_M4;
    7: sw_KTX_Cheong_Ryong_DD_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_KTX_Cheong_Ryong_DD_8car, extra_callback_info1) {
    1..7: KTX_Cheong_Ryong_DD_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }