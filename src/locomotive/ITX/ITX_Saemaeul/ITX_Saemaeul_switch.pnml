/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_ITX_Saemaeul_engineH, train_is_driving_backwards) {
    0: set_ITX_Saemaeul_engineH;
    1: set_ITX_Saemaeul_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_Saemaeul_panto_wagon_M1, train_is_driving_backwards) {
    0: set_ITX_Saemaeul_panto_wagon_M1;
    1: set_ITX_Saemaeul_panto_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_Saemaeul_panto_wagon_M2, train_is_driving_backwards) {
    0: set_ITX_Saemaeul_panto_wagon_M2;
    1: set_ITX_Saemaeul_panto_wagon_M2_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_Saemaeul_engineT, train_is_driving_backwards) {
    0: set_ITX_Saemaeul_engineT;
    1: set_ITX_Saemaeul_engineT_Rev;
}

switch(FEAT_TRAINS, SELF, sw_ITX_Saemaeul_engineT_Free, train_is_driving_backwards) {
    0: set_ITX_Saemaeul_engineT_Free;
    1: set_ITX_Saemaeul_engineT_Free_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_ITX_Saemaeul_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_ITX_Saemaeul_engineT_Free;
    sw_ITX_Saemaeul_engineH;
}

// 객차
switch(FEAT_TRAINS, SELF, sw_ITX_Saemaeul_DD_wagon, position_in_consist % 2) {
    1: set_ITX_Saemaeul_wagon_DUP2;
    set_ITX_Saemaeul_wagon_DUP1;
}

switch (FEAT_TRAINS, SELF, sw_ITX_Saemaeul_Free_wagon_front, position_in_vehid_chain) {
    0: sw_ITX_Saemaeul_panto_wagon_M1;
    set_ITX_Saemaeul_wagon_M;
}

switch (FEAT_TRAINS, SELF, sw_ITX_Saemaeul_Free_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_ITX_Saemaeul_panto_wagon_M2;
    1: set_ITX_Saemaeul_wagon_TM;
    sw_ITX_Saemaeul_Free_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_ITX_Saemaeul_Free_wagon, num_vehs_in_vehid_chain) {
    1..255: sw_ITX_Saemaeul_Free_wagon_full;
    set_ITX_Saemaeul_wagon_M;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_ITX_Saemaeul_6car, position_in_vehid_chain % 6) {
    0: sw_ITX_Saemaeul_engineH; //default
    1: sw_ITX_Saemaeul_panto_wagon_M1;
    2: set_ITX_Saemaeul_wagon_M;
    3: set_ITX_Saemaeul_wagon_TM;
    4: sw_ITX_Saemaeul_panto_wagon_M2;
    5: sw_ITX_Saemaeul_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_ITX_Saemaeul_6car, extra_callback_info1) {
    1..5: ITX_Saemaeul_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }