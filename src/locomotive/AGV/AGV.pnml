/*--------------------------------------------------------------------
AGV
--------------------------------------------------------------------*/
// Graphics
#include "AGV_graphic.pnml"

// Switch
#include "AGV_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, AGV_engine, 2025){
    property {
        name:                           string(STR_AGV_engine_NAME);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2012, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        dual_headed:                    1;
        
        //spec
        speed:                          300km/h;
        power:                          18000 kW;
        weight:                         37 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 85;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_MU, TRAIN_FLAG_AUTOREFIT);
        extra_weight_per_wagon:         35 ton;
        }
        
    graphics {
        default:                        sw_AGV_engine;
        purchase:                       set_AGV_engine_purchase;
        speed:                          sw_High_300_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        }
    
    livery_override(AGV_wagon) {
        default:                        sw_AGV_wagon;
        loading_speed:                  25;
        }
        }

/*--------------------------------------------------------------------
객차
--------------------------------------------------------------------*/
