/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_DTX_Glory_subtype_text, cargo_subtype) {
    0: return string(Livery_DTX_Glory_APEC_2025);
    1: return string(Livery_DTX_Glory_1Year);
    2: return string(Livery_DTX_Glory_2Year);
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_DTX_Glory_engineH_Front, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_engineH;
    1: set_DTX_Glory_engineH;
    2: set_DTX_Glory_2year_engineH;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T1, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T1;
    1: set_DTX_Glory_wagon_T1;
    2: set_DTX_Glory_2year_wagon_T1;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T2, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T2;
    1: set_DTX_Glory_wagon_T2;
    2: set_DTX_Glory_2year_wagon_T2;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T3, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T3;
    1: set_DTX_Glory_wagon_T3;
    2: set_DTX_Glory_2year_wagon_T3;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T4, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T4;
    1: set_DTX_Glory_wagon_T4;
    2: set_DTX_Glory_2year_wagon_T4;    
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T5, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T5;
    1: set_DTX_Glory_wagon_T5;
    2: set_DTX_Glory_2year_wagon_T5;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T6, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T6;
    1: set_DTX_Glory_wagon_T6;
    2: set_DTX_Glory_2year_wagon_T6;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T7, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T7;
    1: set_DTX_Glory_wagon_T7;
    2: set_DTX_Glory_2year_wagon_T7;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T8, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T8;
    1: set_DTX_Glory_wagon_T8;
    2: set_DTX_Glory_2year_wagon_T8;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_T9, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_wagon_T9;
    1: set_DTX_Glory_wagon_T9;
    2: set_DTX_Glory_2year_wagon_T9;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_engineT_Front, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_engineT;
    1: set_DTX_Glory_engineT;
    2: set_DTX_Glory_2year_engineT;
}

// 후진방향
switch(FEAT_TRAINS, SELF, sw_DTX_Glory_engineH_Back, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_engineH_Rev;
    1: set_DTX_Glory_engineH_Rev;
    2: set_DTX_Glory_2year_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_engineT_Back, cargo_subtype) {
    0: set_DTX_Glory_APEC_2025_engineT_Rev;
    1: set_DTX_Glory_engineT_Rev;
    2: set_DTX_Glory_2year_engineT_Rev;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTX_Glory_engineH, train_is_driving_backwards) {
    0: sw_DTX_Glory_engineH_Front;
    1: sw_DTX_Glory_engineH_Back;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Glory_engineT, train_is_driving_backwards) {
    0: sw_DTX_Glory_engineT_Front;
    1: sw_DTX_Glory_engineT_Back;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTX_Glory_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTX_Glory_engineT;
    sw_DTX_Glory_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_front, position_in_vehid_chain) {
    0..2: sw_DTX_Glory_wagon_T1;
    3..4: sw_DTX_Glory_wagon_T2;
    5..6: sw_DTX_Glory_wagon_T3;
    7..8: sw_DTX_Glory_wagon_T4;
    sw_DTX_Glory_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_back, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0..1: sw_DTX_Glory_wagon_T9;
    2..3: sw_DTX_Glory_wagon_T8;
    4..5: sw_DTX_Glory_wagon_T7;
    6..7: sw_DTX_Glory_wagon_T6;
    sw_DTX_Glory_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_short, position_in_vehid_chain * 2 < num_vehs_in_vehid_chain) {
    1: sw_DTX_Glory_wagon_front;
    0: sw_DTX_Glory_wagon_back;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Glory_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0..7: sw_DTX_Glory_wagon_back;
    sw_DTX_Glory_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Glory_wagon, num_vehs_in_vehid_chain) {
     1..17:  sw_DTX_Glory_wagon_short;
    18..255: sw_DTX_Glory_wagon_full;
    sw_DTX_Glory_wagon_T5;
}