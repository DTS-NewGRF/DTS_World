// 도색명
switch(FEAT_TRAINS, SELF, sw_DTX_Glory_subtype_text, cargo_subtype) {
    0: return string(STR_REFIT_LIVERY_DTX_Glory_APEC_2025);
    1: return string(STR_REFIT_LIVERY_DTX_Glory_1Year);
    2: return string(STR_REFIT_LIVERY_DTX_Glory_2Year);
}

