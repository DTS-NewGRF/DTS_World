/*--------------------------------------------------------------------
DTX_CityLink_120
--------------------------------------------------------------------*/
// Graphics
#include "DTX_CityLink_120_graphic.pnml"

// Switch
#include "DTX_CityLink_120_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DTS_CityLink_120, 1081){
    property {
        name:                           string(NAME_Group_DTS_CityLink_120);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          1680 kW;
        variant_group:                  DTX_Logo;
        }

    graphics {
        purchase:                       set_DTX_CityLink_120_engine_Pass_purchase;
        }
        }

/*--------------------------------------------------------------------
열차정보
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DTS_CityLink_120_Pass_engine, 1082){
    property {
        name:                           string(NAME_DTX_CityLink_120_Pass_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2017, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  DTS_CityLink_120;
        
        //spec
        speed:                          150km/h;
        power:                          500 kW;
        weight:                         35 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 76;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

    graphics {
        default:                        sw_DTX_CityLink_120_engine_Pass;
        purchase:                       set_DTX_CityLink_120_engine_Pass_purchase;
        speed:                          sw_Regular_150_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_TOSHIBAStart_sound;
        }
    
    livery_override(DTS_CityLink_120_Pass_wagon) {
        default:                        sw_DTX_CityLink_120_wagon_Pass;
        loading_speed:                  25;
        power:                          671;
        }
        }

