/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_engineH, train_is_driving_backwards) {
    0: set_DCL_150_1st_engineH;
    1: set_DCL_150_1st_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_panto_wagon_M1, train_is_driving_backwards) {
    0: set_DCL_150_1st_panto_wagon_M1;
    1: set_DCL_150_1st_panto_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_panto_wagon_M2, train_is_driving_backwards) {
    0: set_DCL_150_1st_panto_wagon_M2;
    1: set_DCL_150_1st_panto_wagon_M2_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_engineT, train_is_driving_backwards) {
    0: set_DCL_150_1st_engineT;
    1: set_DCL_150_1st_engineT_Rev;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_DCL_150_1st_4car, position_in_vehid_chain % 4) {
    0: sw_DCL_150_1st_engineH;
    1: sw_DCL_150_1st_panto_wagon_M1;
    2: sw_DCL_150_1st_panto_wagon_M2;
    3: sw_DCL_150_1st_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_DCL_150_1st_6car, position_in_vehid_chain % 6) {
    0: sw_DCL_150_1st_engineH;
    1: sw_DCL_150_1st_panto_wagon_M1;
    2: set_DCL_150_1st_wagon_M;
    3: set_DCL_150_1st_wagon_T;
    4: sw_DCL_150_1st_panto_wagon_M2;
    5: sw_DCL_150_1st_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_DCL_150_1st_8car, position_in_vehid_chain % 8) {
    0: sw_DCL_150_1st_engineH;
    1: sw_DCL_150_1st_panto_wagon_M1;
    2: set_DCL_150_1st_wagon_M;
    3: set_DCL_150_1st_wagon_T;
    4: set_DCL_150_1st_wagon_T;
    5: set_DCL_150_1st_wagon_M;
    6: sw_DCL_150_1st_panto_wagon_M2;
    7: sw_DCL_150_1st_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_DCL_150_1st_10car, position_in_vehid_chain % 10) {
    0: sw_DCL_150_1st_engineH;
    1: sw_DCL_150_1st_panto_wagon_M1;
    2: set_DCL_150_1st_wagon_M;
    3: set_DCL_150_1st_wagon_T;
    4: set_DCL_150_1st_wagon_T;
    5: set_DCL_150_1st_wagon_T;
    6: set_DCL_150_1st_wagon_T;
    7: set_DCL_150_1st_wagon_M;
    8: sw_DCL_150_1st_panto_wagon_M2;
    9: sw_DCL_150_1st_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_DCL_150_1st_4car, extra_callback_info1) {
    1..3: DCL_150_1st_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DCL_150_1st_6car, extra_callback_info1) {
    1..5: DCL_150_1st_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DCL_150_1st_8car, extra_callback_info1) {
    1..7: DCL_150_1st_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DCL_150_1st_10car, extra_callback_info1) {
    1..9: DCL_150_1st_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }