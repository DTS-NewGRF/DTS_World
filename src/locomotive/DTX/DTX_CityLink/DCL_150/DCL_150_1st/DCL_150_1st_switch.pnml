/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_DCL_150_1st_T);
    1: return string(Livery_DCL_150_1st_M);
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_engineH, train_is_driving_backwards) {
    0: set_DCL_150_1st_engineH;
    1: set_DCL_150_1st_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_panto_wagon, train_is_driving_backwards) {
    0: set_DCL_150_1st_panto_wagon;
    1: set_DCL_150_1st_panto_wagon_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_engineT, train_is_driving_backwards) {
    0: set_DCL_150_1st_engineT;
    1: set_DCL_150_1st_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DCL_150_1st_engineT;
    sw_DCL_150_1st_engineH;
}

// 객차
switch(FEAT_TRAINS, SELF, sw_DCL_150_1st_wagon, cargo_subtype) {
    0: set_DCL_150_1st_wagon_T;
    1: set_DCL_150_1st_wagon_M;
}