/*--------------------------------------------------------------------
DTX_CityLink_150 2세대
--------------------------------------------------------------------*/
// Graphics
#include "DCL_150_2nd_graphic.pnml"

// Switch
#include "DCL_150_2nd_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DCL_150_2nd, 1122){
    property {
        name:                           string(NAME_Group_DCL_150_2nd);
        climates_available:             NO_CLIMATE;
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        power:                          2400 kW;
        variant_group:                  DTX_Logo;
        }

    graphics {
        purchase:                       set_DCL_150_2nd_purchase;
        }
        }

/*--------------------------------------------------------------------
열차정보
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DCL_150_2nd_4Car, 1139){
    property {
        name:                           string(NAME_DCL_150_2nd_4Car);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2030, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  DCL_150_2nd;
        
        //spec
        speed:                          150km/h;
        power:                          1680 kW;
        weight:                         33 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 87;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

    graphics {
        default:                        sw_DCL_150_2nd_4car;
        articulated_part:               sw_articulated_DCL_150_2nd_4car;
        purchase:                       set_DCL_150_2nd_purchase;
        speed:                          sw_Regular_150_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_TOSHIBASicStart_sound;
        }
        }

