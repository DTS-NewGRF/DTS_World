/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_150_1st_engineH, train_is_driving_backwards) {
    0: set_DTS_CityLink_150_1st_engineH;
    1: set_DTS_CityLink_150_1st_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_150_1st_panto_wagon_M1, train_is_driving_backwards) {
    0: set_DTS_CityLink_150_1st_panto_wagon_M1;
    1: set_DTS_CityLink_150_1st_panto_wagon_M1_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_150_1st_panto_wagon_M2, train_is_driving_backwards) {
    0: set_DTS_CityLink_150_1st_panto_wagon_M2;
    1: set_DTS_CityLink_150_1st_panto_wagon_M2_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_150_1st_engineT, train_is_driving_backwards) {
    0: set_DTS_CityLink_150_1st_engineT;
    1: set_DTS_CityLink_150_1st_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTS_CityLink_150_1st_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTS_CityLink_150_1st_engineT;
    sw_DTS_CityLink_150_1st_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_DTS_CityLink_150_1st_wagon_front, position_in_vehid_chain) {
    0: sw_DTS_CityLink_150_1st_panto_wagon_M1;
    1: set_DTS_CityLink_150_1st_wagon_M;
    set_DTS_CityLink_150_1st_wagon_T;
}

switch (FEAT_TRAINS, SELF, sw_DTS_CityLink_150_1st_Free_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0: sw_DTS_CityLink_150_1st_panto_wagon_M2;
    sw_DTS_CityLink_150_1st_wagon_front;
}