/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTS_R001_engineH, train_is_driving_backwards) {
    0: set_DTS_R001_engineH;
    1: set_DTS_R001_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_R001_engineT, train_is_driving_backwards) {
    0: set_DTS_R001_engineT;
    1: set_DTS_R001_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTS_R001_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTS_R001_engineT;
    sw_DTS_R001_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_DTS_R001_wagon_MT_front, position_in_consist) {
    1: set_DTS_R001_panto_wagon_M1;
    set_DTS_R001_wagon_MT;
}

switch (FEAT_TRAINS, SELF, sw_DTS_R001_wagon, position_in_consist_from_end) {
    1: set_DTS_R001_panto_wagon_M2;
    sw_DTS_R001_wagon_MT_front;
}