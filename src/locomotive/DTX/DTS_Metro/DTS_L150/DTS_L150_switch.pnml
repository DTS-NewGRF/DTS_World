/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTS_L150_engineH, train_is_driving_backwards) {
    0: set_DTS_L150_engineH;
    1: set_DTS_L150_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_L150_engineT, train_is_driving_backwards) {
    0: set_DTS_L150_engineT;
    1: set_DTS_L150_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTS_L150_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTS_L150_engineT;
    sw_DTS_L150_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_DTS_L150_4car_wagon_front, position_in_consist) {
    1: set_DTS_L150_panto_wagon_only_4car;
    set_DTS_L150_wagon_MTT1;
}

switch (FEAT_TRAINS, SELF, sw_DTS_L150_wagon_front, position_in_consist) {
    1: set_DTS_L150_panto_wagon;
    set_DTS_L150_wagon_MTT1;
}

// 1층
switch (FEAT_TRAINS, SELF, sw_DTS_L150_4car_wagon, position_in_consist_from_end) {
    1: set_DTS_L150_panto_wagon;
    sw_DTS_L150_4car_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_DTS_L150_wagon_nomal, position_in_consist_from_end) {
    1: set_DTS_L150_panto_wagon;
    sw_DTS_L150_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_DTS_L150_wagon, num_vehs_in_consist) {
    4: sw_DTS_L150_4car_wagon;
    sw_DTS_L150_wagon_nomal;
}