/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 도색명
switch(FEAT_TRAINS, SELF, sw_DTS_L150_cargo_subtype_text, cargo_subtype) {
    0: return string(STR_REFIT_LIVERY_L150_1F);
    1: return string(STR_REFIT_LIVERY_L150_2F);
}

// 도색그래픽 세팅
// 열차
// 전진방향
switch(FEAT_TRAINS, SELF, sw_DTS_L150_wagon_T, cargo_subtype) {
    0: set_DTS_L150_wagon_MTT1;
    1: set_DTS_L150_2F_wagon;
}

// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTS_L150_engineH, train_is_driving_backwards) {
    0: set_DTS_L150_engineH;
    1: set_DTS_L150_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTS_L150_engineT, train_is_driving_backwards) {
    0: set_DTS_L150_engineT;
    1: set_DTS_L150_engineT_Rev;
}

// 편성그래픽
// 4량
switch (FEAT_TRAINS, SELF, sw_DTS_L150_4car, position_in_vehid_chain % 4) {
    0: sw_DTS_L150_engineH; //default
    1: set_DTS_L150_panto_wagon_only_4car;
    2: set_DTS_L150_panto_wagon;
    3: sw_DTS_L150_engineT;
    }

// 6량
switch (FEAT_TRAINS, SELF, sw_DTS_L150_6car, position_in_vehid_chain % 6) {
    0: sw_DTS_L150_engineH; //default
    1: set_DTS_L150_panto_wagon;
    2..3: set_DTS_L150_wagon_MTT1;
    4: set_DTS_L150_panto_wagon;
    5: sw_DTS_L150_engineT;
    }

// 8량
switch (FEAT_TRAINS, SELF, sw_DTS_L150_8car, position_in_vehid_chain % 8) {
    0: sw_DTS_L150_engineH; //default
    1: set_DTS_L150_panto_wagon;
    2: set_DTS_L150_wagon_MTT1;
    3..4: sw_DTS_L150_wagon_T;
    5: set_DTS_L150_wagon_MTT1;
    6: set_DTS_L150_panto_wagon;
    7: sw_DTS_L150_engineT;
    }

// 10량
switch (FEAT_TRAINS, SELF, sw_DTS_L150_10car, position_in_vehid_chain % 10) {
    0: sw_DTS_L150_engineH; //default
    1: set_DTS_L150_wagon_MTT1;
    2: set_DTS_L150_panto_wagon;
    3: set_DTS_L150_wagon_MTT1;
    4: set_DTS_L150_panto_wagon;
    5..6: sw_DTS_L150_wagon_T;
    7: set_DTS_L150_panto_wagon;
    8: set_DTS_L150_wagon_MTT1;
    9: sw_DTS_L150_engineT;
    }

// 12량
switch (FEAT_TRAINS, SELF, sw_DTS_L150_12car, position_in_vehid_chain % 12) {
    0: sw_DTS_L150_engineH; //default
    1: set_DTS_L150_panto_wagon;
    2: set_DTS_L150_wagon_MTT1;
    3: set_DTS_L150_panto_wagon;
    4: set_DTS_L150_wagon_MTT1;
    5..6: set_DTS_L150_2F_wagon;
    7..8: set_DTS_L150_wagon_MTT1;
    9: set_DTS_L150_panto_wagon;
    10: set_DTS_L150_wagon_MTT1;
    11: sw_DTS_L150_engineT;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_DTS_L150_4car, extra_callback_info1) {
    1..3: DTS_L150_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTS_L150_6car, extra_callback_info1) {
    1..5: DTS_L150_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTS_L150_8car, extra_callback_info1) {
    1..7: DTS_L150_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTS_L150_10car, extra_callback_info1) {
    1..9: DTS_L150_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTS_L150_12car, extra_callback_info1) {
    1..11: DTS_L150_12Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

// 수송량
switch(FEAT_TRAINS, SELF, sw_DTS_L150_8Car_capacity_in_custom, cargo_subtype) {
    1: return 105;
       108;
}

switch(FEAT_TRAINS, SELF, sw_DTS_L150_10Car_capacity_in_custom, cargo_subtype) {
    1: return 106;
       108;
}

// 중량
switch(FEAT_TRAINS, SELF, sw_DTS_L150_8Car_weight_in_custom, cargo_subtype) {
    1: return 296;
       280;
}

switch(FEAT_TRAINS, SELF, sw_DTS_L150_10Car_weight_in_custom, cargo_subtype) {
    1: return 366;
       350;
}