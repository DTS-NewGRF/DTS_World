/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTX_Sundeok_engineH, train_is_driving_backwards) {
    0: set_DTX_Sundeok_engineH;
    1: set_DTX_Sundeok_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Sundeok_engineT, train_is_driving_backwards) {
    0: set_DTX_Sundeok_engineT;
    1: set_DTX_Sundeok_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTX_Sundeok_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTX_Sundeok_engineT;
    sw_DTX_Sundeok_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_DTX_Sundeok_wagon_front, position_in_vehid_chain) {
    0..2: set_DTX_Sundeok_wagon_T1;
    3..4: set_DTX_Sundeok_wagon_T2;
    5..6: set_DTX_Sundeok_wagon_T3;
    7..8: set_DTX_Sundeok_wagon_T4;
    set_DTX_Sundeok_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Sundeok_wagon_back, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0..1: set_DTX_Sundeok_wagon_T9;
    2..3: set_DTX_Sundeok_wagon_T8;
    4..5: set_DTX_Sundeok_wagon_T7;
    6..7: set_DTX_Sundeok_wagon_T6;
    set_DTX_Sundeok_wagon_T5;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Sundeok_wagon_short, position_in_vehid_chain * 2 < num_vehs_in_vehid_chain) {
    1: sw_DTX_Sundeok_wagon_front;
    0: sw_DTX_Sundeok_wagon_back;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Sundeok_wagon_full, num_vehs_in_vehid_chain - 1 - position_in_vehid_chain) {
    0..7: sw_DTX_Sundeok_wagon_back;
    sw_DTX_Sundeok_wagon_front;
}

switch (FEAT_TRAINS, SELF, sw_DTX_Sundeok_wagon, num_vehs_in_vehid_chain) {
     1..17:  sw_DTX_Sundeok_wagon_short;
    18..255: sw_DTX_Sundeok_wagon_full;
    sw_DTX_Sundeok_wagon_full;
}