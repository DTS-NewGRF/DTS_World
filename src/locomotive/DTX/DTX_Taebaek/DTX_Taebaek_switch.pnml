/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTX_Taebaek_engineH, train_is_driving_backwards) {
    0: set_DTX_Taebaek_engineH;
    1: set_DTX_Taebaek_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Taebaek_engineT, train_is_driving_backwards) {
    0: set_DTX_Taebaek_engineT;
    1: set_DTX_Taebaek_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTX_Taebaek_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTX_Taebaek_engineT;
    sw_DTX_Taebaek_engineH;
}

// 1.03 삭제예정
// 고정편성 그래픽
switch (FEAT_TRAINS, SELF, sw_DTX_Taebaek_6car, position_in_vehid_chain % 6) {
    0: set_Deleted_A; //default
    1..5: set_Deleted_B;
    }

switch (FEAT_TRAINS, SELF, sw_DTX_Taebaek_8car, position_in_vehid_chain % 8) {
    0: set_Deleted_A; //default
    1..7: set_Deleted_B;
    }

switch (FEAT_TRAINS, SELF, sw_DTX_Taebaek_10car, position_in_vehid_chain % 10) {
    0: set_Deleted_A; //default
    1..9: set_Deleted_B;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_DTX_Taebaek_6car, extra_callback_info1) {
    1..5: DTX_Taebaek_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTX_Taebaek_8car, extra_callback_info1) {
    1..7: DTX_Taebaek_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTX_Taebaek_10car, extra_callback_info1) {
    1..9: DTX_Taebaek_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }