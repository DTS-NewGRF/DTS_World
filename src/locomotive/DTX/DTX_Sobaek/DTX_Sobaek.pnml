/*--------------------------------------------------------------------
DTX-소백
--------------------------------------------------------------------*/
// Graphics
#include "DTX_Sobaek_graphic.pnml"

// Switch
#include "DTX_Sobaek_switch.pnml"

/*--------------------------------------------------------------------
기관차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DTX_Sobaek_engine, 1103){
    property {
        name:                           string(NAME_DTX_Sobaek_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2020, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  DTX_Logo;
        dual_headed:                    1;
        
        //spec
        speed:                          151km/h;
        power:                          8000 kW;
        weight:                         40 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        visual_effect_and_powered:      VISUAL_EFFECT_DISABLE;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 100;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT);
        extra_weight_per_wagon:         35 ton;
        }

	graphics {
        default:                        sw_DTX_Sobaek_engine;
        purchase:                       set_DTX_Sobaek_engine_purchase;
        speed:                          sw_Regular_150_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_TOSHIBAIGBTPMSMstart_sound;
        }
        }

/*--------------------------------------------------------------------
객차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, DTX_Sobaek_wagon, 1104){
    property {
        name:                           string(NAME_DTX_Sobaek_wagon);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2020, 1, 1);
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_DIESEL;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  Train_Car;
        
        //spec
        weight:                         40 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        visual_effect_and_powered:      VISUAL_EFFECT_DISABLE;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 100;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT);
        extra_weight_per_wagon:         35 ton;
        }

	graphics {
        default:                        set_DTX_Sobaek_wagon;
        purchase:                       set_DTX_Sobaek_wagon_purchase;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        }
        }