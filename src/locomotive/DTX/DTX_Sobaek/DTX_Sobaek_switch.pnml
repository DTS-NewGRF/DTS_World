// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTX_Sobaek_engineH, train_is_driving_backwards) {
    0: set_DTX_Sobaek_engineH;
    1: set_DTX_Sobaek_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Sobaek_engineT, train_is_driving_backwards) {
    0: set_DTX_Sobaek_engineT;
    1: set_DTX_Sobaek_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTX_Sobaek_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTX_Sobaek_engineT;
    sw_DTX_Sobaek_engineH;
}