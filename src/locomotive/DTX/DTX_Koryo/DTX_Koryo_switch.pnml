/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTX_Koryo_engineH, train_is_driving_backwards) {
    0: set_DTX_Koryo_engineH;
    1: set_DTX_Koryo_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTX_Koryo_engineT, train_is_driving_backwards) {
    0: set_DTX_Koryo_engineT;
    1: set_DTX_Koryo_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_DTX_Koryo_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_DTX_Koryo_engineT;
    sw_DTX_Koryo_engineH;
}

// 객차
switch (FEAT_TRAINS, SELF, sw_DTX_Koryo_wagon_9car, position_in_vehid_chain % 9) {
    0: set_DTX_Koryo_wagon_T1;
    1: set_DTX_Koryo_wagon_T2;
    2: set_DTX_Koryo_wagon_T3;
    3: set_DTX_Koryo_wagon_T4;
    4: set_DTX_Koryo_wagon_T5;
    5: set_DTX_Koryo_wagon_T6;
    6: set_DTX_Koryo_wagon_T7;
    7: set_DTX_Koryo_wagon_T8;
    8: set_DTX_Koryo_wagon_T9;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_DTX_Koryo_wagon_9car, extra_callback_info1) {
    1..8: DTX_Koryo_wagon_9car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }