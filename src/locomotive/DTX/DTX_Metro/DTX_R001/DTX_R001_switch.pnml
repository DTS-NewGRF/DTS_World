/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_DTX_R001_engineH, train_is_driving_backwards) {
    0: set_DTX_R001_engineH;
    1: set_DTX_R001_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_DTX_R001_engineT, train_is_driving_backwards) {
    0: set_DTX_R001_engineT;
    1: set_DTX_R001_engineT_Rev;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_DTX_R001_4car, position_in_vehid_chain % 4) {
    0: sw_DTX_R001_engineH;
    1: set_DTX_R001_panto_wagon;
    2: set_DTX_R001_panto_wagon;
    3: sw_DTX_R001_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_DTX_R001_6car, position_in_vehid_chain % 6) {
    0: sw_DTX_R001_engineH;
    1: set_DTX_R001_panto_wagon;
    2: set_DTX_R001_wagon;
    3: set_DTX_R001_wagon;
    4: set_DTX_R001_panto_wagon;
    5: sw_DTX_R001_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_DTX_R001_8car, position_in_vehid_chain % 8) {
    0: sw_DTX_R001_engineH;
    1: set_DTX_R001_panto_wagon;
    2: set_DTX_R001_wagon;
    3: set_DTX_R001_wagon;
    4: set_DTX_R001_wagon;
    5: set_DTX_R001_wagon;
    6: set_DTX_R001_panto_wagon;
    7: sw_DTX_R001_engineT;
    }

switch (FEAT_TRAINS, SELF, sw_DTX_R001_10car, position_in_vehid_chain % 10) {
    0: sw_DTX_R001_engineH;
    1: set_DTX_R001_panto_wagon;
    2: set_DTX_R001_wagon;
    3: set_DTX_R001_wagon;
    4: set_DTX_R001_wagon;
    5: set_DTX_R001_wagon;
    6: set_DTX_R001_wagon;
    7: set_DTX_R001_wagon;
    8: set_DTX_R001_panto_wagon;
    9: sw_DTX_R001_engineT;
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_DTX_R001_4car, extra_callback_info1) {
    1..3: DTX_R001_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTX_R001_6car, extra_callback_info1) {
    1..5: DTX_R001_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTX_R001_8car, extra_callback_info1) {
    1..7: DTX_R001_8Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_DTX_R001_10car, extra_callback_info1) {
    1..9: DTX_R001_10Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }