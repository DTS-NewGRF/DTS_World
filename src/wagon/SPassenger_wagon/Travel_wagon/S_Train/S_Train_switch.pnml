/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
//도색
switch(FEAT_TRAINS, SELF, sw_S_Train_cargo_subtype_text, cargo_subtype) {
    0: return string(Livery_S_Train_Old_B);
    1: return string(Livery_S_Train_Old_P);
    2: return string(Livery_S_Train_New);
    return CB_RESULT_NO_TEXT;
}

//객차
switch(FEAT_TRAINS, SELF, sw_S_Train_wagon1_5car, cargo_subtype) {
    1: set_S_Train_Old_P_1wagon;
    2: set_S_Train_New_1wagon;
    set_S_Train_Old_B_1wagon;
}

switch(FEAT_TRAINS, SELF, sw_S_Train_wagon2_5car, cargo_subtype) {
    1: set_S_Train_Old_P_2wagon;
    2: set_S_Train_New_2wagon;
    set_S_Train_Old_B_2wagon;
}

switch(FEAT_TRAINS, SELF, sw_S_Train_wagon3_5car, cargo_subtype) {
    1: set_S_Train_Old_P_3wagon;
    2: set_S_Train_New_3wagon;
    set_S_Train_Old_B_3wagon;
}

switch(FEAT_TRAINS, SELF, sw_S_Train_wagon4_5car, cargo_subtype) {
    1: set_S_Train_Old_P_4wagon;
    2: set_S_Train_New_4wagon;
    set_S_Train_Old_B_4wagon;
}

switch(FEAT_TRAINS, SELF, sw_S_Train_wagon5_5car, cargo_subtype) {
    1: set_S_Train_Old_P_5wagon;
    2: set_S_Train_New_5wagon;
    set_S_Train_Old_B_5wagon;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_S_Train_New_4car, position_in_vehid_chain % 4) {
    1:set_S_Train_New_2wagon;
    2:set_S_Train_New_3wagon;
    3:set_S_Train_New_4wagon;
    set_S_Train_New_1wagon; //default
    }

switch (FEAT_TRAINS, SELF, sw_S_Train_wagon_5car, position_in_vehid_chain % 5) {
    1:sw_S_Train_wagon2_5car;
    2:sw_S_Train_wagon3_5car;
    3:sw_S_Train_wagon4_5car;
    4:sw_S_Train_wagon5_5car;
    sw_S_Train_wagon1_5car; //default
    }

// 편성량
switch (FEAT_TRAINS, SELF, sw_articulated_S_Train_New_4car, extra_callback_info1) {
    1..3: S_Train_New_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_S_Train_5car, extra_callback_info1) {
    1..4: S_Train_5Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }