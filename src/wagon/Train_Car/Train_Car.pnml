/*--------------------------------------------------------------------
공통객차
--------------------------------------------------------------------*/
// Graphics
#include "Train_Car_graphic.pnml"

// Switch
#include "Train_Car_switch.pnml"

/*--------------------------------------------------------------------
열차정보 그룹
--------------------------------------------------------------------*/
item(FEAT_TRAINS, Train_Car, 1000){
    property {
        name:                           string(NAME_Train_Car);
        climates_available:             NO_CLIMATE;
        track_type:                     RAIL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        }

    graphics {
        purchase:                       set_Train_purchase;
        }
        }

/*--------------------------------------------------------------------
AREX 객차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, AREX_wagon, 1148){
    property {
        name:                           string(NAME_AREX_wagon);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2006, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  Train_Car;
        
        //spec
        weight:                         33 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 50;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        cost_factor:                    10;
        running_cost_factor:            150;
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC);
        extra_weight_per_wagon:         35 ton;
        }
        
    graphics {
        default:                        sw_AREX_wagon;
        purchase:                       sw_AREX_1000_1st_wagon_purchase;
        loading_speed:                  25;
        cargo_subtype_text:             sw_AREX_wagon_cargo_subtype_text;
        }
        }

