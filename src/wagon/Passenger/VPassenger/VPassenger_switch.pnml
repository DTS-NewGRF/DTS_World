switch(FEAT_TRAINS, SELF, sw_VPassenger_cargo_subtype_text, cargo_subtype) {
    0: return string(Paint_VPassenger_BR);
    1: return string(Paint_VPassenger_Taegeuk);     // 태극 도색
}

switch(FEAT_TRAINS, SELF, sw_VPassenger_wagon, cargo_subtype) {
    0: set_VPassenger_wagon;
    1: set_VPassenger_Taegeuk_wagon;
}