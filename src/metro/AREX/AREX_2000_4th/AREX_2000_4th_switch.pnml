/*--------------------------------------------------------------------
스위치
--------------------------------------------------------------------*/
// 전후진 통합 코드
switch(FEAT_TRAINS, SELF, sw_AREX_2000_4th_engineH, train_is_driving_backwards) {
    0: set_AREX_2000_4th_engineH;
    1: set_AREX_2000_4th_engineH_Rev;
}

switch(FEAT_TRAINS, SELF, sw_AREX_2000_4th_engineT, train_is_driving_backwards) {
    0: set_AREX_2000_4th_engineT;
    1: set_AREX_2000_4th_engineT_Rev;
}

// 기관차
switch(FEAT_TRAINS, SELF, sw_AREX_2000_4th_engine, position_in_consist_from_end == 0 && num_vehs_in_consist > 1) {
    1: sw_AREX_2000_4th_engineT;
    sw_AREX_2000_4th_engineH;
}

// 편성그래픽
switch (FEAT_TRAINS, SELF, sw_AREX_2000_4th_wagon_4car, position_in_vehid_chain % 4) {
    0..3: set_AREX_2000_4th_wagon;
    }

// 편성수
switch (FEAT_TRAINS, SELF, sw_articulated_AREX_2000_4th_wagon_4car, extra_callback_info1) {
    1..3: AREX_2000_4th_wagon_4Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }

// 삭제예정
switch (FEAT_TRAINS, SELF, sw_AREX_2000_4th_6car, position_in_vehid_chain % 6) {
    0: set_Deleted_A; //default
    1..5: set_Deleted_B;
    }

switch (FEAT_TRAINS, SELF, sw_articulated_AREX_2000_4th_6car, extra_callback_info1) {
    1..5: APEX_2000_4th_6Car;
    return CB_RESULT_NO_MORE_ARTICULATED_PARTS;
    }