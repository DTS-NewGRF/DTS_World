/*--------------------------------------------------------------------
넥스트레인
--------------------------------------------------------------------*/
// Graphics
#include "Nextrain_graphic.pnml"

// Switch
#include "Nextrain_switch.pnml"

/*--------------------------------------------------------------------
자유편성
--------------------------------------------------------------------*/
item(FEAT_TRAINS, Nextrain_engine, 1018){
    property {
        name:                           string(NAME_Nextrain_engine);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2025, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        dual_headed:                    1;
        
        //spec
        speed:                          110km/h;
        power:                          1680 kW;
        weight:                         33 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 117;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

    graphics {
        default:                        sw_Nextrain_engine;
        purchase:                       set_Nextrain_engine_purchase;
        speed:                          sw_Metro_110_speed;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        sound_effect:                   sw_DAWONSYSIGBT2start_sound;
        start_stop:                     sw_start_stop_3Car;
        }
        }

/*--------------------------------------------------------------------
객차
--------------------------------------------------------------------*/
item(FEAT_TRAINS, Nextrain_wagon, 1019){
    property {
        name:                           string(NAME_Nextrain_wagon);
        climates_available:             ALL_CLIMATES;
        introduction_date:              date(2025, 1, 1);
        track_type:                     ELRL;
        engine_class:                   ENGINE_CLASS_ELECTRIC;
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
        variant_group:                  Train_Car;
        
        //spec
        weight:                         33 ton;
        tractive_effort_coefficient:    0.3;
        air_drag_coefficient:           0.01;
        
        //Model
        model_life:                     VEHICLE_NEVER_EXPIRES;
        vehicle_life:                   30;
        retire_early:                   0;
        reliability_decay:              0;
        
        //Cargo
        cargo_capacity:                 117;
        refittable_cargo_classes:       NO_CARGO_CLASS;
        non_refittable_cargo_classes:   NO_CARGO_CLASS;
        cargo_allow_refit:              [PASS];
        cargo_disallow_refit:           [];
        
        //Costs
        refit_cost:                     0;
        running_cost_base:              RUNNING_COST_ELECTRIC;
        
        //Flags
        misc_flags:                     bitmask(TRAIN_FLAG_FLIP, TRAIN_FLAG_AUTOREFIT, TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK);
        extra_weight_per_wagon:         35 ton;
        }

    graphics {
        default:                        set_Nextrain_wagon;
        purchase:                       set_Nextrain_wagon_purchase;
        loading_speed:                  25;
        cost_factor:                    10;
        running_cost_factor:            150;
        }
        }